class SourceType(Enum):
    """Supported source types for scanning."""
    AZURE_DEVOPS = "azure-devops"
    GITHUB = "github"


class ModuleSourceType(Enum):
    """Supported Terraform module source types."""
    LOCAL = "local"
    GIT = "git"


class APIError(Exception):
    """Raised when API operations fail."""
    pass


class BaseAPIClient:
    """Base API client with common functionality."""
    
    def _make_api_request(self, url: str, headers: dict) -> dict:
        """Make an authenticated API request with comprehensive error handling."""
        try:
            req = urllib.request.Request(url, headers=headers)
            with urllib.request.urlopen(req, timeout=UTMSConfig.API_TIMEOUT_SECONDS) as response:
                if response.status == 200:
                    return json.loads(response.read().decode())
                else:
                    raise APIError(f"API request failed with status {response.status}")
        except urllib.error.HTTPError as e:
            error_body = e.read().decode() if e.fp else "No error details"
            raise APIError(f"HTTP {e.code}: {error_body}")
        except urllib.error.URLError as e:
            raise APIError(f"Network error: {e}")
        except json.JSONDecodeError as e:
            raise APIError(f"Invalid JSON response: {e}")
        except Exception as e:
            raise APIError(f"API request failed: {e}")


class ScanError(Exception):
    """Raised when scanning operations fail."""
    pass


class AuthenticationError(Exception):
    """Raised when authentication fails."""
    pass


@dataclass(frozen=True)
class ModuleReference:
    """Terraform module reference with source path, version, and location info."""
    source: str
    local_name: str = ""
    version: Optional[str] = None
    file_path: str = ""
    line_number: int = 0
    project_name: str = ""
    repository_name: str = ""
    source_type: ModuleSourceType = ModuleSourceType.LOCAL
    latest_version: Optional[str] = None
    is_outdated: Optional[bool] = None
    
    def __post_init__(self):
        """Validate module reference after initialization."""
        if not self.source:
            raise ValueError("Module source cannot be empty")


@dataclass  
class ScanResult:
    """Results from scanning a repository for Terraform modules."""
    source_type: SourceType
    organization: str
    project_name: str = ""
    repository_name: str = ""
    total_files_scanned: int = 0
    total_modules_found: int = 0
    local_modules_found: int = 0
    git_modules_found: int = 0
    repository_accessible: bool = True
    modules: List[ModuleReference] = field(default_factory=list)
    scan_timestamp: str = field(default_factory=lambda: datetime.now().isoformat())
    
    def add_module(self, module_ref: ModuleReference):
        """Add a module reference to the results."""
        self.modules.append(module_ref)
        self.total_modules_found += 1
        if module_ref.source_type == ModuleSourceType.LOCAL:
            self.local_modules_found += 1
        elif module_ref.source_type == ModuleSourceType.GIT:
            self.git_modules_found += 1


class TerraformFileScanner:
    """Scans Terraform files for module references."""
    
    def __init__(self):
        # Primary configuration files that can contain module blocks
        self.terraform_file_patterns = ['.tf', '.tf.json']
        
        # Variable files that should NOT be scanned (they don't contain module blocks)
        # .tfvars and .tfvars.json only contain variable assignments, not module declarations
        self.variable_file_patterns = ['.tfvars', '.tfvars.json', '.auto.tfvars', '.auto.tfvars.json']
        
        # Files and directories to ignore during scanning
        self.ignore_patterns = [
            '.terraform/',       # Terraform working directory
            '*.tfstate',         # State files
            '*.tfstate.backup',  # State backup files
            '.terraform.lock.hcl', # Dependency lock file
            '*.tfplan',          # Plan files
            'terraform.tfvars',  # Variable files (don't contain modules)
            'terraform.tfvars.json',
            '*.auto.tfvars',
            '*.auto.tfvars.json',
            'crash.log',         # Terraform crash logs
            '.terraformrc',      # CLI configuration
            'terraform.rc'       # CLI configuration (Windows)
        ]
    
    def _is_valid_terraform_version_constraint(self, version_str: str) -> bool:
        """Check if version string is a valid Terraform constraint or Git ref."""
        if not version_str:
            return False
            
        version_str = version_str.strip()
        
        # Check for common Terraform version constraint patterns (semantic versions)
        constraint_patterns = [
            r'^~>\s*\d+(\.\d+)*',           # Pessimistic: ~> 1.0, ~> 1.2.3
            r'^>=\s*\d+(\.\d+)*',           # Greater than equal: >= 1.0.0
            r'^<=\s*\d+(\.\d+)*',           # Less than equal: <= 2.0.0
            r'^>\s*\d+(\.\d+)*',            # Greater than: > 1.0.0
            r'^<\s*\d+(\.\d+)*',            # Less than: < 2.0.0
            r'^!=\s*\d+(\.\d+)*',           # Not equal: != 1.0.0
            r'^=\s*\d+(\.\d+)*',            # Exact: = 1.0.0
            r'^\d+(\.\d+)*$',               # Simple version: 1.0.0, 1.2
            r'^\d+(\.\d+)*\s*,\s*',         # Complex constraints with commas
        ]
        
        for pattern in constraint_patterns:
            if re.match(pattern, version_str):
                return True
        
        # Check for Git refs (tags, branches, commit SHAs)
        git_ref_patterns = [
            r'^v\d+(\.\d+)*',                      # Version tags: v1.0.0, v1.2
            r'^[a-zA-Z][a-zA-Z0-9_-]*',            # Branch names: main, develop, feature/something
            r'^[0-9a-f]{7,40}$',                   # Commit SHAs: short (7+) or full (40 char)
            r'^[a-zA-Z0-9_-]+/[a-zA-Z0-9_.-]+$',  # Refs with slashes: refs/tags/v1.0.0
        ]
        
        for pattern in git_ref_patterns:
            if re.match(pattern, version_str):
                return True
        
        # Reject common non-constraint values
        non_constraint_values = {
            'latest', 'stable', 'production', 'development', 'test', 'staging',
            'windows', 'linux', 'ubuntu', 'centos', 'rhel', 'debian',
            'server', 'desktop', 'core', 'standard', 'enterprise',
            'true', 'false', 'yes', 'no', 'enabled', 'disabled'
        }
        
        if version_str.lower() in non_constraint_values:
            return False
            
        return False
    
    def detect_module_source_type(self, source: str) -> ModuleSourceType:
        """Detect if module source is LOCAL or GIT."""
        if not source:
            return ModuleSourceType.LOCAL  # Default fallback
        
        # Check if it's a Git repository
        if source.startswith(('git::', 'git@', 'ssh://', 'git://')):
            return ModuleSourceType.GIT
        
        # Check if it's an HTTPS Git repository (git::https://)
        if source.startswith('git::https://') or source.startswith('git::http://'):
            return ModuleSourceType.GIT
        
        # Everything else is considered LOCAL (including ./path, ../path, /absolute/path, ~/home/path)
        return ModuleSourceType.LOCAL
    
    def _extract_git_revision(self, source: str) -> Optional[str]:
        """Extract Git revision from query parameters (ref= or version=)."""
        if '?' not in source:
            return None
        
        try:
            # Extract query string portion
            query_string = source.split('?', 1)[1]
            
            # Look for ref= or version= parameter
            match = re.search(r'(?:ref|version)=([^&]+)', query_string)
            if match:
                return match.group(1)
        except Exception:
            pass
        
        return None
    
    def scan_content(self, content: str, file_path: str, project_name: str, repository_name: str) -> List[ModuleReference]:
        """Scan Terraform file content for module references."""
        modules = []
        
        if file_path.endswith('.tf.json'):
            modules.extend(self._scan_json_content(content, file_path, project_name, repository_name))
        else:
            modules.extend(self._scan_hcl_content(content, file_path, project_name, repository_name))
        
        return modules
    
    def _scan_hcl_content(self, content: str, file_path: str, project_name: str, repository_name: str) -> List[ModuleReference]:
        """Scan HCL (.tf) file content for module blocks."""
        modules = []
        lines = content.splitlines()
        
        in_module_block = False
        current_module = {}
        brace_count = 0
        
        for line_num, line in enumerate(lines, 1):
            stripped = line.strip()
            
            # Skip comments and empty lines
            if not stripped or stripped.startswith('#') or stripped.startswith('//'):
                continue
            
            # Check for start of module block
            if not in_module_block and stripped.startswith('module '):
                in_module_block = True
                current_module = self._extract_module_name(stripped, line_num)
                brace_count = 0
            
            if in_module_block:
                # Count braces to track block depth
                brace_count += line.count('{') - line.count('}')
                
                # Extract source and version
                current_module = self._extract_module_properties(line, current_module)
                
                # End of module block
                if brace_count <= 0 and '}' in line:
                    in_module_block = False
                    
                    # Create module reference if we found a source
                    module_ref = self._create_module_reference(current_module, file_path, project_name, repository_name)
                    if module_ref:
                        modules.append(module_ref)
                    
                    current_module = {}
        
        return modules
    
    def _extract_module_name(self, line: str, line_number: int) -> dict:
        """Extract module local name from module declaration line."""
        module_info = {'line_number': line_number}
        
        try:
            # Find the local name between quotes
            match = re.search(r'module\s+"([^"]+)"', line)
            if match:
                module_info['local_name'] = match.group(1)
            else:
                # Try single quotes as fallback
                match = re.search(r"module\s+'([^']+)'", line)
                if match:
                    module_info['local_name'] = match.group(1)
                else:
                    module_info['local_name'] = "unknown"
        except Exception:
            module_info['local_name'] = "unknown"
        
        return module_info
    
    def _extract_module_properties(self, line: str, current_module: dict) -> dict:
        """Extract source and version properties from module block line."""
        if '=' in line:
            key, value = line.split('=', 1)
            key = key.strip()
            value = value.strip().strip('"').strip("'")
            
            if key == 'source':
                current_module['source'] = value
            elif key == 'version' and self._is_valid_terraform_version_constraint(value):
                current_module['version'] = value
        
        return current_module
    
    def _create_module_reference(self, module_data: dict, file_path: str, project_name: str, repository_name: str) -> Optional[ModuleReference]:
        """Create a ModuleReference from extracted module data."""
        if 'source' not in module_data:
            return None
        
        source = module_data['source']
        source_type = self.detect_module_source_type(source)
        
        # For Git sources, extract revision from query parameters
        version = module_data.get('version')
        if source_type == ModuleSourceType.GIT and not version:
            version = self._extract_git_revision(source)
        
        module_ref = ModuleReference(
            source=source,
            local_name=module_data.get('local_name', 'unknown'),
            version=version,
            file_path=file_path,
            line_number=module_data['line_number'],
            project_name=project_name,
            repository_name=repository_name,
            source_type=source_type
        )
        
        # Validate the module reference
        if self.validate_module_reference(module_ref):
            return module_ref
        
        return None
    
    def _scan_json_content(self, content: str, file_path: str, project_name: str, repository_name: str) -> List[ModuleReference]:
        """Scan JSON (.tf.json) file content for module blocks."""
        modules = []
        
        try:
            data = json.loads(content)
            
            # Look for module blocks in JSON structure
            if 'module' in data and isinstance(data['module'], dict):
                for module_name, module_config in data['module'].items():
                    if isinstance(module_config, dict):
                        source = module_config.get('source')
                        version = module_config.get('version')
                        
                        if source:
                            source_type = self.detect_module_source_type(source)
                            
                            # For Git sources, extract revision from query parameters if not specified
                            if source_type == ModuleSourceType.GIT and not version:
                                version = self._extract_git_revision(source)
                            
                            module_ref = ModuleReference(
                                source=source,
                                local_name=module_name,  # In JSON, the key is the local name
                                version=version,
                                file_path=file_path,
                                line_number=1,  # JSON doesn't have meaningful line numbers for blocks
                                project_name=project_name,
                                repository_name=repository_name,
                                source_type=source_type
                            )
                            
                            # Validate the module reference
                            if self.validate_module_reference(module_ref):
                                modules.append(module_ref)
        
        except (json.JSONDecodeError, KeyError, TypeError) as e:
            logger.debug(f"Error parsing JSON file {file_path}: {e}")
        
        return modules
    
    def is_terraform_file(self, file_path: str) -> bool:
        """Check if a file is a Terraform file we should scan."""
        return any(file_path.endswith(pattern) for pattern in self.terraform_file_patterns)
    
    def should_ignore_path(self, file_path: str) -> bool:
        """Check if a file path should be ignored during scanning."""
        for pattern in self.ignore_patterns:
            if fnmatch.fnmatch(file_path, pattern) or pattern in file_path:
                return True
        return False
    
    def is_variable_file(self, file_path: str) -> bool:
        """Check if a file is a variable file (shouldn't be scanned for modules)."""
        return any(file_path.endswith(pattern) for pattern in self.variable_file_patterns)
    
    def validate_module_reference(self, module_ref: ModuleReference) -> bool:
        """Validate module reference has correct format for its source type."""
        if not module_ref.source:
            return False
        
        source_type = module_ref.source_type
        
        if source_type == ModuleSourceType.LOCAL:
            # Local paths should not be empty after stripping
            source = module_ref.source.strip()
            return len(source) > 0
        
        elif source_type == ModuleSourceType.GIT:
            # Git URLs should start with git:: or git@ or ssh:// or git://
            source = module_ref.source.lower()
            valid_prefixes = ('git::', 'git@', 'ssh://', 'git://')
            return source.startswith(valid_prefixes)
        
        return False


# Repository Discovery and Scanning Classes

@dataclass
class Repository:
    """Represents a source control repository."""
    name: str
    id: str
    project_name: str = ""
    project_id: str = ""
    default_branch: str = "main"
    web_url: str = ""
    clone_url: str = ""
    size_kb: int = 0
    source_type: SourceType = SourceType.AZURE_DEVOPS
    
    @property
    def full_name(self) -> str:
        """Get full repository name including project."""
        if self.project_name:
            return f"{self.project_name}/{self.name}"
        return self.name


class RepositoryDiscovery(BaseAPIClient):
    """Discovers and lists repositories from source control providers."""
    
    def __init__(self, source_type: SourceType, auth_manager: 'AuthenticationManager'):
        self.source_type = source_type
        self.auth_manager = auth_manager
    
    def get_repository(self, organization: str, project: str, repository_name: str, token: str) -> Optional[Repository]:
        """Get a specific repository."""
        if self.source_type == SourceType.AZURE_DEVOPS:
            return self._get_azure_devops_repository(organization, project, repository_name, token)
        if self.source_type == SourceType.GITHUB:
            return self._get_github_repository(organization, repository_name, token)
        raise ValueError(f"Unsupported source type: {self.source_type}")
    
    def _get_azure_devops_repository(self, organization: str, project: str, repository_name: str, token: str) -> Optional[Repository]:
        """Get a specific Azure DevOps repository."""
        headers = self.auth_manager.get_headers(self.source_type, token)
        
        try:
            # Get the repository details directly
            repo_url = f'https://dev.azure.com/{organization}/{project}/_apis/git/repositories/{repository_name}?api-version=6.0'
            repo = self._make_api_request(repo_url, headers)
            
            if repo:
                return Repository(
                    name=repo['name'],
                    id=repo['id'],
                    project_name=project,
                    project_id=repo.get('project', {}).get('id', ''),
                    default_branch=repo.get('defaultBranch', 'refs/heads/main').replace('refs/heads/', ''),
                    web_url=repo.get('webUrl', ''),
                    clone_url=repo.get('remoteUrl', ''),
                    size_kb=repo.get('size', 0),
                    source_type=self.source_type
                )
        except Exception as e:
            logger.error(f"Error getting Azure DevOps repository: {e}")
            return None
        
        return None
    
    def _get_github_repository(self, organization: str, repository_name: str, token: str) -> Optional[Repository]:
        """Get a specific GitHub repository."""
        headers = self.auth_manager.get_headers(self.source_type, token)
        
        try:
            # Get the repository details
            repo_url = f'https://api.github.com/repos/{organization}/{repository_name}'
            repo = self._make_api_request(repo_url, headers)
            
            if repo:
                return Repository(
                    name=repo['name'],
                    id=str(repo['id']),
                    project_name=organization,
                    project_id=organization,
                    default_branch=repo.get('default_branch', 'main'),
                    web_url=repo.get('html_url', ''),
                    clone_url=repo.get('clone_url', ''),
                    size_kb=repo.get('size', 0),
                    source_type=self.source_type
                )
        except Exception as e:
            logger.error(f"Error getting GitHub repository: {e}")
            return None
        
        return None


class RepositoryScanner(BaseAPIClient):
    """Scans repositories for Terraform files and module references."""
    
    def __init__(self, source_type: SourceType, auth_manager: 'AuthenticationManager', file_scanner: TerraformFileScanner, version_checker: 'GitModuleVersionChecker'):
        self.source_type = source_type
        self.auth_manager = auth_manager
        self.file_scanner = file_scanner
        self.version_checker = version_checker
        self.max_file_size_bytes = UTMSConfig.MAX_FILE_SIZE_BYTES
        self.use_concurrent_processing = True  # Enable concurrent processing by default
    
    @lru_cache(maxsize=UTMSConfig.CACHE_SIZE_LIMIT)
    def _cached_api_request(self, url: str, headers_tuple: tuple) -> dict:
        """Make cached API request to avoid redundant calls."""
        # Convert tuple back to dict for the actual request
        headers = dict(headers_tuple)
        return self._make_api_request(url, headers)
    
    def _make_cached_request(self, url: str, headers: dict) -> dict:
        """Make an API request with caching support."""
        # Convert headers to tuple for caching (tuples are hashable)
        headers_tuple = tuple(sorted(headers.items()))
        return self._cached_api_request(url, headers_tuple)
    
    def scan_repository(self, repository: Repository, organization: str, token: str) -> ScanResult:
        """Scan repository for Terraform module references."""
        logger.info(f"🔍 Scanning repository: {repository.full_name}")
        
        result = ScanResult(
            source_type=self.source_type,
            organization=organization,
            project_name=repository.project_name,
            repository_name=repository.name
        )
        
        try:
            # Precompute headers once to avoid repeated auth_manager calls
            headers = self.auth_manager.get_headers(self.source_type, token)
            
            # Get file tree and validate repository access
            terraform_files = self._get_and_validate_files(repository, organization, token, headers, result)
            if not result.repository_accessible:
                return result
            
            # Scan each file for module references
            self._scan_terraform_files(repository, organization, token, headers, terraform_files, result)
            
            # Check versions for Git modules
            self._check_module_versions(result, token)
        
        except Exception as e:
            logger.error(f"Error scanning repository {repository.full_name}: {e}")
        
        logger.info(f"  ✅ Found {result.local_modules_found} local + {result.git_modules_found} git modules in {repository.name}")
        return result
    
    def _get_and_validate_files(self, repository: Repository, organization: str, token: str, headers: Dict[str, str], result: ScanResult) -> List[dict]:
        """Get terraform files from repository and validate access."""
        # Get file tree from repository
        terraform_files = self._discover_terraform_files(repository, organization, token, headers)
        result.total_files_scanned = len(terraform_files)
        
        logger.info(f"  📄 Found {len(terraform_files)} Terraform files")
        
        # Check if repository is accessible (if no files found, it might be disabled)
        if len(terraform_files) == 0:
            # Additional check to see if repository access failed
            test_access = self._test_repository_access(repository, organization, token)
            if not test_access:
                result.repository_accessible = False
                logger.info(f"  🔒 Repository appears to be disabled or inaccessible")
        
        return terraform_files
    
    def _scan_terraform_files(self, repository: Repository, organization: str, token: str, headers: Dict[str, str],
                             terraform_files: List[dict], result: ScanResult) -> None:
        """Scan each terraform file for module references."""
        # Use concurrent processing for larger file sets
        if self.use_concurrent_processing and len(terraform_files) > UTMSConfig.MIN_FILES_FOR_CONCURRENT_PROCESSING:
            self._scan_terraform_files_concurrent(repository, organization, token, headers, terraform_files, result)
        else:
            self._scan_terraform_files_sequential(repository, organization, token, headers, terraform_files, result)
    
    def _scan_terraform_files_sequential(self, repository: Repository, organization: str, token: str, headers: Dict[str, str],
                                       terraform_files: List[dict], result: ScanResult) -> None:
        """Scan terraform files sequentially (original method)."""
        for file_info in terraform_files:
            try:
                modules = self._process_single_file(repository, file_info, organization, token, headers)
                for module in modules:
                    result.add_module(module)
                if modules:
                    logger.info(f"    📦 {file_info['path']}: {len(modules)} modules")
            except Exception as e:
                logger.warning(f"    ⚠️ Error scanning {file_info['path']}: {e}")
                continue
    
    def _scan_terraform_files_concurrent(self, repository: Repository, organization: str, token: str, headers: Dict[str, str],
                                       terraform_files: List[dict], result: ScanResult) -> None:
        """Scan terraform files concurrently for improved performance."""
        logger.debug(f"    🚀 Using concurrent file processing ({UTMSConfig.MAX_CONCURRENT_FILES} workers)")
        
        with concurrent.futures.ThreadPoolExecutor(max_workers=UTMSConfig.MAX_CONCURRENT_FILES) as executor:
            future_to_file = {
                executor.submit(self._process_single_file, repository, file_info, organization, token, headers): file_info
                for file_info in terraform_files
            }
            
            for future in concurrent.futures.as_completed(future_to_file):
                file_info = future_to_file[future]
                try:
                    modules = future.result()
                    for module in modules:
                        result.add_module(module)
                    if modules:
                        logger.info(f"    📦 {file_info['path']}: {len(modules)} modules")
                except Exception as e:
                    logger.warning(f"    ⚠️ Error processing file {file_info['path']}: {e}")
    
    def _process_single_file(self, repository: Repository, file_info: dict, organization: str, token: str, headers: Dict[str, str]) -> List['ModuleReference']:
        """Process a single file and return discovered modules (for concurrent processing)."""
        logger.debug(f"    🔍 Scanning file: {file_info['path']} ({file_info.get('size', 0)} bytes)")
        file_content = self._get_file_content(repository, file_info, organization, headers)
        
        if not file_content:
            logger.debug(f"    ❌ Could not retrieve file content")
            return []
        
        # Log content preview for debugging
        preview = file_content[:UTMSConfig.CONTENT_PREVIEW_LENGTH].replace('\n', '\\n').replace('\r', '\\r')
        logger.debug(f"    👀 Content preview: {preview}")
        
        # Check if content contains module blocks
        if 'module ' in file_content:
            logger.debug(f"    🎯 File contains 'module ' blocks")
        else:
            logger.debug(f"    ➡️  File does not contain module blocks")
        
        modules = self.file_scanner.scan_content(
            content=file_content,
            file_path=file_info['path'],
            project_name=repository.project_name,
            repository_name=repository.name
        )
        
        logger.debug(f"    📊 Scan result: {len(modules)} modules found")
        for module in modules:
            logger.debug(f"    ✅ Module '{module.local_name}': {module.source} (type: {module.source_type.value})")
        
        return modules
    
    def _check_module_versions(self, result: ScanResult, token: str) -> None:
        """Check versions for all Git modules and update result."""
        git_modules = [m for m in result.modules if m.source_type == ModuleSourceType.GIT]
        
        if not git_modules:
            return
        
        logger.info(f"  🔍 Checking versions for {len(git_modules)} Git modules...")
        
        # Set tokens for version checking
        # Try to get GitHub token from environment if not the primary source
        github_token = None
        azure_token = None
        
        if self.source_type == SourceType.GITHUB:
            github_token = token
        elif self.source_type == SourceType.AZURE_DEVOPS:
            azure_token = token
            # Try to get GitHub token from environment for cross-platform checks
            github_token = self.auth_manager.authenticate(SourceType.GITHUB, "")
        
        self.version_checker.set_tokens(azure_token=azure_token, github_token=github_token)
        
        # Create a new list with version info
        updated_modules = []
        outdated_count = 0
        
        for module in result.modules:
            if module.source_type == ModuleSourceType.GIT:
                latest_version, is_outdated = self.version_checker.check_module_version(module)
                
                # Create updated module with version info
                updated_module = ModuleReference(
                    source=module.source,
                    local_name=module.local_name,
                    version=module.version,
                    file_path=module.file_path,
                    line_number=module.line_number,
                    project_name=module.project_name,
                    repository_name=module.repository_name,
                    source_type=module.source_type,
                    latest_version=latest_version,
                    is_outdated=is_outdated
                )
                updated_modules.append(updated_module)
                
                if is_outdated:
                    outdated_count += 1
                    logger.info(f"    ⚠️  {module.local_name}: {module.version} → {latest_version} (outdated)")
                elif latest_version:
                    logger.debug(f"    ✅ {module.local_name}: {module.version or 'no version'} (latest: {latest_version})")
            else:
                updated_modules.append(module)
        
        # Replace modules list with updated one
        result.modules.clear()
        result.modules.extend(updated_modules)
        
        if outdated_count > 0:
            logger.info(f"  ⚠️  {outdated_count} outdated Git module(s) detected")
    
