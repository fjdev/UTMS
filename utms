            safe_print(f"   Top providers:")
            for provider, count in sorted(summary.modules_by_provider.items(), key=lambda x: x[1], reverse=True)[:3]:
                safe_print(f"     • {provider}: {count} modules")
        
        # Version constraint distribution
        if summary.version_constraints_used:
            safe_print(f"   Version constraints:")
            for constraint_type, count in sorted(summary.version_constraints_used.items(), key=lambda x: x[1], reverse=True):
                constraint_name = constraint_type.replace('_', ' ').title()
                safe_print(f"     • {constraint_name}: {count} modules")


def save_and_display_results(args, summary: ScanSummary, all_results: List[ScanResult], results_manager: ResultsManager) -> None:
    """Save results and display completion status."""
    # Save results (with TMVS enrichment if cross-reference requested)
    tmvs_dir = getattr(args, 'cross_reference', None)
    output_file = results_manager.save_scan_results(args.organization, SourceType(args.source), all_results, summary, tmvs_dir)
    
    safe_print(f"\n💾 Detailed results saved to: {output_file}")
    
    # Show enrichment status
    if tmvs_dir:
        safe_print(f"🔗 Results enriched with TMVS data from: {tmvs_dir}")
    
    safe_print(f"\n✅ UTMS scan completed successfully!")


def setup_application(args) -> None:
    """Setup application configuration and logging."""
    # Ignore SIGPIPE to prevent broken pipe errors when piping to head/tail
    signal.signal(signal.SIGPIPE, signal.SIG_DFL)
    
    if args.debug:
        # Enable both INFO and DEBUG messages in debug mode
        logging.getLogger().setLevel(logging.INFO)
    
    # Display clean application header
    safe_print(f"🚀 UTMS v{__version__} - Universal Terraform Module Scanner")
    safe_print(f"🎯 Source: {args.source} | 🏢 Organization: {args.organization}")
    if args.debug:
        safe_print(f"🐛 Debug mode enabled")
    safe_print()  # Empty line for spacing


def run_application_workflow(args) -> int:
    """Run the complete application workflow."""
    try:
        # Initialize application and authenticate
        source_type, auth_manager, token = initialize_application(args)
        
        # Create results directory relative to UTMS script location
        script_dir = os.path.dirname(os.path.abspath(__file__))
        results_dir = os.path.join(script_dir, "results")
        
        # Initialize scanning components
        file_scanner, repo_discovery, repo_scanner, results_manager = initialize_scanning_components(auth_manager, source_type, results_dir)
        
        # Clean existing results if requested
        if args.clean:
            results_manager.clean_existing_results(args.organization, source_type)
        
        # Discover repositories
        repositories = discover_and_validate_repositories(args, repo_discovery, token)
        if not repositories:
            return 0
        
        # Execute main scanning process
        return execute_main_scanning_process(args, repositories, repo_scanner, results_manager)
        
    except KeyboardInterrupt:
        safe_print(f"\n⏹️  Scan interrupted by user")
        return UTMSConfig.EXIT_CODE_INTERRUPT
    except Exception as e:
        safe_print(f"\n❌ Unexpected error: {e}")
        logger.error(f"Application error: {e}")
        return 1


def main() -> int:
    """Main application entry point."""
    args = parse_arguments()
    setup_application(args)
    return run_application_workflow(args)

if __name__ == "__main__":
    sys.exit(main())
