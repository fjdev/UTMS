class AuthenticationManager:
    """Manages authentication across different source types."""
    
    def __init__(self):
        self.auth_providers = {}
        self._setup_providers()
    
    def _setup_providers(self):
        """Set up authentication providers for each source type."""
        # Azure DevOps providers
        self.auth_providers[SourceType.AZURE_DEVOPS] = [
            EnvironmentAuthProvider(['AZURE_DEVOPS_PAT', 'AZURE_PAT', 'ADO_PAT']),
            # Keychain provider will be added dynamically per organization
        ]
    
    def authenticate(self, source_type: SourceType, organization: str = "") -> Optional[str]:
        """Authenticate for a specific source type and organization."""
        if source_type not in self.auth_providers:
            logger.error(f"Unsupported source type: {source_type}")
            return None
        
        # Create dynamic provider list for this organization
        providers = self.auth_providers[source_type].copy()
        
        # Add organization-specific keychain provider
        if source_type == SourceType.AZURE_DEVOPS and organization:
            keychain_provider = KeychainAuthProvider(
                f'azure-devops-{organization}',
                'personal-access-token'
            )
            providers.append(keychain_provider)
        
        # Add interactive provider as fallback
        if source_type == SourceType.AZURE_DEVOPS:
            interactive_provider = AzureDevOpsInteractiveAuthProvider(organization)
            providers.append(interactive_provider)
        
        # Try each provider in sequence
        for provider in providers:
            try:
                logger.debug(f"Trying authentication via {provider.get_name()}")
                token = provider.get_token()
                if token:
                    if self._validate_token(source_type, token, organization):
                        logger.info(f"✅ Authenticated via {provider.get_name()}")
                        return token
                    else:
                        logger.warning(f"❌ Invalid token from {provider.get_name()}")
            except Exception as e:
                logger.debug(f"Authentication provider {provider.get_name()} failed: {e}")
        
        logger.error(f"❌ Authentication failed for {source_type.value}")
        return None
    
    def _validate_token(self, source_type: SourceType, token: str, organization: str = "") -> bool:
        """Validate token by making a test API call."""
        try:
            if source_type == SourceType.AZURE_DEVOPS:
                return self._validate_azure_devops_token(token, organization)
            # Add other source types here
            return False
        except Exception as e:
            logger.debug(f"Token validation failed: {e}")
            return False
    
    def _validate_azure_devops_token(self, token: str, organization: str) -> bool:
        """Validate Azure DevOps token."""
        import urllib.request
        import urllib.error
        import base64
        
        try:
            # Encode token for basic auth
            auth_string = base64.b64encode(f':{token}'.encode()).decode()
            
            # Test API call to list projects
            url = f'https://dev.azure.com/{organization}/_apis/projects?api-version=6.0'
            req = urllib.request.Request(url)
            req.add_header('Authorization', f'Basic {auth_string}')
            req.add_header('Accept', 'application/json')
            
            with urllib.request.urlopen(req, timeout=UTMSConfig.TOKEN_VALIDATION_TIMEOUT) as response:
                if response.status == UTMSConfig.HTTP_OK:
                    import json
                    data = json.loads(response.read().decode())
                    project_count = data.get('count', 0)
                    logger.debug(f"Token validation successful - found {project_count} projects")
                    return True
            return False
        except urllib.error.HTTPError as e:
            logger.debug(f"HTTP error during token validation: {e.code}")
            return False
        except Exception as e:
            logger.debug(f"Token validation error: {e}")
            return False
    
    def get_headers(self, source_type: SourceType, token: str) -> Dict[str, str]:
        """Get HTTP headers for API requests."""
        if source_type == SourceType.AZURE_DEVOPS:
            import base64
            auth_string = base64.b64encode(f':{token}'.encode()).decode()
            return {
                'Authorization': f'Basic {auth_string}',
                'Accept': 'application/json'
            }
        # Add other source types here
        return {}
    
    def get_token(self, source_type: SourceType = None, organization: str = "") -> Optional[str]:
        """
        Compatibility method that wraps authenticate().
        This method is kept for backward compatibility with existing code.
        """
        if source_type is None:
            source_type = SourceType.AZURE_DEVOPS  # Default fallback
        return self.authenticate(source_type, organization)


# Output Management and Results Storage

class ResultsManager:
    """Manages scanning results output and storage."""
    
    def __init__(self, output_dir: str = "results"):
        self.output_dir = output_dir
        self._ensure_output_directory()
    
    def _ensure_output_directory(self):
        """Create output directory if it doesn't exist."""
        import os
        if not os.path.exists(self.output_dir):
            os.makedirs(self.output_dir)
            logger.info(f"📁 Created output directory: {self.output_dir}")
    
    def save_scan_results(self, organization: str, source_type: SourceType, all_results: List[ScanResult], summary: 'ScanSummary', tmvs_directory: str = None) -> str:
        """
        Save scan results to JSON file.
        
        Args:
            organization: Organization name
            source_type: Source type (azure-devops, github)
            all_results: List of all scan results
            summary: Scan summary
            tmvs_directory: Optional path to TMVS results for enrichment
            
        Returns:
            Path to the saved file
            
        Raises:
            OSError: If file cannot be written
            json.JSONEncodeError: If data cannot be serialized
        """
        # Load TMVS data for enrichment if provided
        tmvs_data = self._load_tmvs_data_for_enrichment(tmvs_directory)
        
        # Prepare output data structure
        output_data = self._build_output_data_structure(organization, source_type, summary, tmvs_data)
        
        # Add detailed results for each repository
        self._add_detailed_repository_results(output_data, all_results, tmvs_data)
        
        # Calculate version status counts from enriched data
        self._calculate_version_status_counts(output_data, summary)
        
        # Save to file
        return self._save_output_data_to_file(output_data, organization)
    
    def _load_tmvs_data_for_enrichment(self, tmvs_directory: str) -> dict:
        """Load TMVS data for enrichment if provided."""
        tmvs_data = {}
        if tmvs_directory:
            try:
                tmvs_data = self._load_tmvs_data(tmvs_directory)
            except Exception as e:
                logger.warning(f"Failed to load TMVS data from {tmvs_directory}: {e}")
        return tmvs_data
    
    def _build_output_data_structure(self, organization: str, source_type: SourceType, summary: 'ScanSummary', tmvs_data: dict) -> dict:
        """Build the main output data structure."""
        return {
            "scan_metadata": {
                "organization": organization,
                "source_type": source_type.value,
                "scan_timestamp": summary.scan_timestamp,
                "utms_version": __version__,
                "total_repositories": summary.total_repositories,
                "total_files_scanned": summary.total_files_scanned,
                "total_modules_found": summary.total_modules_found,
                "total_registry_modules": summary.total_registry_modules,
                "projects_scanned": summary.projects_scanned,
                "tmvs_enriched": bool(tmvs_data)
            },
            "summary_statistics": {
                "modules_by_registry": summary.modules_by_registry,
                "modules_by_provider": summary.modules_by_provider,
                "modules_by_namespace": summary.modules_by_namespace,
                "version_constraints_used": summary.version_constraints_used,
                "version_status_counts": summary.version_status_counts,
                "repositories_with_modules": summary.repositories_with_modules
            },
            "detailed_results": []
        }
    
    def _add_detailed_repository_results(self, output_data: dict, all_results: List[ScanResult], tmvs_data: dict) -> None:
        """Add detailed results for each repository."""
        for result in all_results:
            repo_data = self._build_repository_data(result)
            self._add_module_data_to_repository(repo_data, result, tmvs_data)
            
            if result.modules:  # Only include repositories that have modules
                output_data["detailed_results"].append(repo_data)
    
    def _build_repository_data(self, result: ScanResult) -> dict:
        """Build repository data structure."""
        return {
            "repository": {
                "name": result.repository_name,
                "project": result.project_name,
                "full_name": f"{result.project_name}/{result.repository_name}" if result.project_name else result.repository_name
            },
            "scan_results": {
                "files_scanned": result.total_files_scanned,
                "modules_found": result.total_modules_found,
                "registry_modules_found": result.registry_modules_found,
                "scan_timestamp": result.scan_timestamp
            },
            "modules": []
        }
    
    def _add_module_data_to_repository(self, repo_data: dict, result: ScanResult, tmvs_data: dict) -> None:
        """Add module details to repository data."""
        for module in result.modules:
            module_data = self._build_module_data(module)
            self._enrich_module_with_tmvs_data(module_data, module, tmvs_data)
            repo_data["modules"].append(module_data)
    
    def _build_module_data(self, module) -> dict:
        """Build basic module data structure."""
        return {
            "source": module.source,
            "local_name": module.local_name,
            "version": module.version,
            "registry_hostname": module.registry_hostname,
            "namespace": module.namespace,
            "name": module.name,
            "provider": module.provider,
            "file_path": module.file_path,
            "line_number": module.line_number
        }
    
    def _enrich_module_with_tmvs_data(self, module_data: dict, module, tmvs_data: dict) -> None:
        """Enrich module data with TMVS information if available."""
        if tmvs_data:
            tmvs_key = f"{module.namespace}/{module.name}/{module.provider}"
            if tmvs_key in tmvs_data:
                tmvs_module = tmvs_data[tmvs_key]
                module_data["latest_version"] = tmvs_module.get("latest_version")
                
                # Resolve version constraint if we have a version
                if module.version:
                    constraint_resolution = VersionConstraintResolver.resolve_constraint(
                        module.version, 
                        tmvs_module.get("all_versions", [])
                    )
                    module_data["resolved_version"] = constraint_resolution.get("latest_matching")
                else:
                    module_data["resolved_version"] = None
                
                # Add version status indicator
                module_data["version_status"] = self._calculate_version_status(
                    module_data.get("resolved_version"), 
                    module_data.get("latest_version")
                )
            else:
                module_data["latest_version"] = None
                module_data["resolved_version"] = None
                module_data["version_status"] = "unknown"
    
    def _calculate_version_status_counts(self, output_data: dict, summary: 'ScanSummary') -> None:
        """Calculate version status counts from enriched module data."""
        version_status_counts = {}
        
        for repo_result in output_data.get("detailed_results", []):
            for module in repo_result.get("modules", []):
                status = module.get("version_status", "unknown")
                version_status_counts[status] = version_status_counts.get(status, 0) + 1
        
        # Update both the output data and summary
        output_data["summary_statistics"]["version_status_counts"] = version_status_counts
        summary.version_status_counts = version_status_counts
    
    def _calculate_version_status(self, resolved_version: str, latest_version: str) -> str:
        """
        Calculate version status indicator based on major version difference.
        
        Args:
            resolved_version: The version resolved from constraint
            latest_version: The latest available version
            
        Returns:
            - "current" (🟢): resolved and latest have same major version
            - "outdated" (🟠): resolved is 1 major version behind
            - "critical" (🔴): resolved is 2+ major versions behind
            - "unknown" (⚪): versions unavailable or unparseable
        """
        if not resolved_version or not latest_version:
            return "unknown"
        
        try:
            # Parse both versions using the existing version parser
            resolved_major, _, _ = VersionConstraintResolver.parse_version(resolved_version)
            latest_major, _, _ = VersionConstraintResolver.parse_version(latest_version)
            
            major_diff = latest_major - resolved_major
            
            if major_diff == 0:
                return "current"    # 🟢 Same major version
            elif major_diff == 1:
                return "outdated"   # 🟠 One major version behind
            else:
                return "critical"   # 🔴 Two or more major versions behind
                
        except (ValueError, TypeError):
            # If version parsing fails, return unknown
            return "unknown"
    
    def _save_output_data_to_file(self, output_data: dict, organization: str) -> str:
        """Save output data to JSON file."""
        import json
        import os
        
        # Simple filename format: just the organization name (like TMVS uses provider name)
        filename = f"{organization.lower()}.json"
        filepath = os.path.join(self.output_dir, filename)
        
        try:
            with open(filepath, 'w', encoding='utf-8') as f:
                json.dump(output_data, f, indent=2, ensure_ascii=False)
        except OSError as e:
            logger.error(f"Failed to write results to {filepath}: {e}")
            raise
        except (TypeError, ValueError) as e:
            logger.error(f"Failed to serialize results data: {e}")
            raise json.JSONEncodeError(f"Data serialization failed: {e}", str(output_data), 0)
        
        logger.info(f"💾 Results saved to: {filepath}")
        return filepath
    
    def _load_tmvs_data(self, tmvs_directory: str) -> dict:
        """
        Load TMVS data files for enrichment.
        
        Args:
            tmvs_directory: Directory containing TMVS JSON files
            
        Returns:
            Dictionary mapping module keys to module data
            
        Raises:
            OSError: If directory cannot be accessed
        """
        import json
        import os
        import glob
        
        tmvs_data = {}
        tmvs_files = glob.glob(os.path.join(tmvs_directory, "*.json"))
        
        for tmvs_file in tmvs_files:
            try:
                with open(tmvs_file, 'r', encoding='utf-8') as f:
                    provider_data = json.load(f)
                    provider = provider_data.get('provider', os.path.splitext(os.path.basename(tmvs_file))[0])
                    
                    # Index modules by namespace/name/provider for quick lookup
                    for module in provider_data.get('modules', []):
                        key = f"{module.get('namespace', '')}/{module.get('name', '')}/{provider}"
                        tmvs_data[key] = module
                        
            except Exception as e:
                logger.warning(f"Could not load TMVS file {tmvs_file}: {e}")
        
        if tmvs_data:
            logger.info(f"📊 Loaded {len(tmvs_data)} modules from {len(tmvs_files)} TMVS files for enrichment")
        
        return tmvs_data
    
    def clean_existing_results(self, organization: str, source_type: SourceType):
        """Clean existing result files for the organization/source."""
        import os
        import glob
        
        pattern = os.path.join(self.output_dir, f"{organization}_{source_type.value}_*.json")
        existing_files = glob.glob(pattern)
        
        for file_path in existing_files:
            try:
                os.remove(file_path)
                logger.debug(f"🗑️ Removed existing file: {os.path.basename(file_path)}")
            except Exception as e:
                logger.warning(f"Could not remove {file_path}: {e}")
        
        if existing_files:
            logger.info(f"🧹 Cleaned {len(existing_files)} existing result files")
    
    def cross_reference_with_tmvs(self, utms_results_path: str, tmvs_results_dir: str, output_path: str = None) -> str:
        """
        Cross-reference UTMS results with TMVS registry data to resolve version constraints.
        
        Args:
            utms_results_path: Path to UTMS JSON results file
            tmvs_results_dir: Directory containing TMVS JSON files
            output_path: Optional output path for cross-reference results
            
        Returns:
            Path to the cross-reference results file
        """
        # Load and validate input data
        utms_data = self._load_utms_results(utms_results_path)
        tmvs_data = self._load_tmvs_data(tmvs_results_dir)
        
        # Perform cross-reference analysis
        cross_reference_results = self._perform_cross_reference_analysis(utms_data, tmvs_data, utms_results_path, tmvs_results_dir)
        
        # Save and report results
        output_file = self._save_cross_reference_results(cross_reference_results, output_path, utms_data)
        self._print_cross_reference_summary(cross_reference_results, output_file)
        
        return output_file
    
    def _load_utms_results(self, utms_results_path: str) -> dict:
        """Load UTMS results from JSON file."""
        import json
        try:
            with open(utms_results_path, 'r', encoding='utf-8') as f:
                return json.load(f)
        except Exception as e:
            raise ValueError(f"Could not load UTMS results from {utms_results_path}: {e}")
    
    def _load_tmvs_data(self, tmvs_results_dir: str) -> dict:
        """Load and index all TMVS data from directory."""
        import json
        import os
        import glob
        
        tmvs_data = {}
        tmvs_files = glob.glob(os.path.join(tmvs_results_dir, "*.json"))
        
        if not tmvs_files:
            raise ValueError(f"No TMVS JSON files found in {tmvs_results_dir}")
        
        for tmvs_file in tmvs_files:
            try:
                with open(tmvs_file, 'r', encoding='utf-8') as f:
                    provider_data = json.load(f)
                    provider = provider_data.get('provider', os.path.splitext(os.path.basename(tmvs_file))[0])
                    
                    # Index modules by namespace/name for quick lookup
                    for module in provider_data.get('modules', []):
                        key = f"{module.get('namespace', '')}/{module.get('name', '')}/{provider}"
                        tmvs_data[key] = module
                        
            except Exception as e:
                logger.warning(f"Could not load TMVS file {tmvs_file}: {e}")
        
        logger.info(f"📊 Loaded {len(tmvs_data)} modules from {len(tmvs_files)} TMVS files")
        return tmvs_data
    
    def _perform_cross_reference_analysis(self, utms_data: dict, tmvs_data: dict, utms_results_path: str, tmvs_results_dir: str) -> dict:
        """Perform the actual cross-reference analysis between UTMS and TMVS data."""
        cross_reference_results = {
            "metadata": {
                "utms_file": utms_results_path,
                "tmvs_directory": tmvs_results_dir,
                "cross_reference_timestamp": datetime.now().isoformat(),
                "utms_version": __version__
            },
            "summary": {
                "total_modules_analyzed": 0,
                "modules_found_in_tmvs": 0,
                "modules_missing_from_tmvs": 0,
                "constraint_resolutions": 0
            },
            "detailed_analysis": []
        }
        
        # Analyze each module usage
        for repo_result in utms_data.get('detailed_results', []):
            repo_analysis = self._analyze_repository_modules(repo_result, tmvs_data, cross_reference_results['summary'])
            
            if repo_analysis['modules']:
                cross_reference_results['detailed_analysis'].append(repo_analysis)
        
        return cross_reference_results
    
    def _analyze_repository_modules(self, repo_result: dict, tmvs_data: dict, summary: dict) -> dict:
        """Analyze modules in a single repository."""
        repo_analysis = {
            "repository": repo_result['repository'],
            "modules": []
        }
        
        for module in repo_result.get('modules', []):
            summary['total_modules_analyzed'] += 1
            module_analysis = self._analyze_single_module(module, tmvs_data, summary)
            repo_analysis['modules'].append(module_analysis)
        
        return repo_analysis
    
    def _analyze_single_module(self, module: dict, tmvs_data: dict, summary: dict) -> dict:
        """Analyze a single module against TMVS data."""
        # Create lookup key for TMVS data
        namespace = module.get('namespace', '')
        name = module.get('name', '')
        provider = module.get('provider', '')
        tmvs_key = f"{namespace}/{name}/{provider}"
        
        module_analysis = {
            "utms_data": module,
            "tmvs_data": None,
            "constraint_resolution": None,
            "analysis": {
                "found_in_tmvs": False,
                "constraint_type": "unknown",
                "resolved_versions": [],
                "latest_matching": None,
                "total_matching": 0
            }
        }
        
        # Look up module in TMVS data
        if tmvs_key in tmvs_data:
            module_analysis['tmvs_data'] = tmvs_data[tmvs_key]
            module_analysis['analysis']['found_in_tmvs'] = True
            summary['modules_found_in_tmvs'] += 1
            
            # Resolve version constraint
            constraint = module.get('version', '')
            available_versions = tmvs_data[tmvs_key].get('all_versions', [])
            
            if constraint and available_versions:
                resolution = VersionConstraintResolver.resolve_constraint(constraint, available_versions)
                module_analysis['constraint_resolution'] = resolution
                module_analysis['analysis'].update({
                    'constraint_type': resolution['constraint_type'],
                    'resolved_versions': resolution['resolved_versions'],
                    'latest_matching': resolution['latest_matching'],
                    'total_matching': resolution['total_matching']
                })
                summary['constraint_resolutions'] += 1
        else:
            summary['modules_missing_from_tmvs'] += 1
            logger.debug(f"Module not found in TMVS: {tmvs_key}")
        
        return module_analysis
    
    def _save_cross_reference_results(self, cross_reference_results: dict, output_path: str, utms_data: dict) -> str:
        """Save cross-reference results to file."""
        import json
        import os
        
        # Generate output path if not provided
        if not output_path:
            organization = utms_data.get('scan_metadata', {}).get('organization', 'unknown')
            timestamp = datetime.now().strftime('%Y%m%d_%H%M%S')
            filename = f"{organization.lower()}_cross_reference_{timestamp}.json"
            output_path = os.path.join(self.output_dir, filename)
        
        # Save cross-reference results
        with open(output_path, 'w', encoding='utf-8') as f:
            json.dump(cross_reference_results, f, indent=2, ensure_ascii=False)
        
        return output_path
    
    def _print_cross_reference_summary(self, cross_reference_results: dict, output_file: str) -> None:
        """Print summary of cross-reference analysis."""
        summary = cross_reference_results['summary']
        safe_print(f"\n🔗 Cross-Reference Analysis Complete")
        safe_print(f"📊 Total modules analyzed: {summary['total_modules_analyzed']}")
        safe_print(f"✅ Found in TMVS: {summary['modules_found_in_tmvs']}")
        safe_print(f"❌ Missing from TMVS: {summary['modules_missing_from_tmvs']}")
        safe_print(f"🎯 Constraints resolved: {summary['constraint_resolutions']}")
        safe_print(f"💾 Results saved to: {output_file}")


@dataclass
class ScanSummary:
    """Summary statistics from a complete scan operation."""
    organization: str
    source_type: SourceType
    scan_timestamp: str
    total_repositories: int = 0
    total_files_scanned: int = 0
    total_modules_found: int = 0
    total_registry_modules: int = 0
    projects_scanned: List[str] = field(default_factory=list)
    repositories_with_modules: List[str] = field(default_factory=list)
    modules_by_registry: dict = field(default_factory=dict)
    modules_by_provider: dict = field(default_factory=dict)
    modules_by_namespace: dict = field(default_factory=dict)
    version_constraints_used: dict = field(default_factory=dict)
    version_status_counts: dict = field(default_factory=dict)  # New field for version status tracking
    
    def add_scan_result(self, result: ScanResult):
        """Add a repository scan result to the summary."""
        self.total_files_scanned += result.total_files_scanned
        self.total_modules_found += result.total_modules_found
        self.total_registry_modules += result.registry_modules_found
        
        if result.project_name and result.project_name not in self.projects_scanned:
            self.projects_scanned.append(result.project_name)
        
        if result.modules:
            repo_full_name = f"{result.project_name}/{result.repository_name}" if result.project_name else result.repository_name
            self.repositories_with_modules.append(repo_full_name)
        
        # Analyze modules for statistics
        for module in result.modules:
            # Count by registry
            registry = module.registry_hostname or "registry.terraform.io"
            self.modules_by_registry[registry] = self.modules_by_registry.get(registry, 0) + 1
            
            # Count by provider
            if module.provider:
                self.modules_by_provider[module.provider] = self.modules_by_provider.get(module.provider, 0) + 1
            
            # Count by namespace
            if module.namespace:
                self.modules_by_namespace[module.namespace] = self.modules_by_namespace.get(module.namespace, 0) + 1
            
            # Count version constraints
            version_type = self._classify_version_constraint(module.version)
            self.version_constraints_used[version_type] = self.version_constraints_used.get(version_type, 0) + 1
    
    def _classify_version_constraint(self, version: Optional[str]) -> str:
        """Classify the type of version constraint used."""
        if not version:
            return "no_version_specified"
        elif version.startswith("~>"):
            return "pessimistic_constraint"
        elif ">=" in version and "<" in version:
            return "range_constraint"
        elif version.startswith(">="):
            return "minimum_version"
        elif version.startswith(">"):
            return "greater_than"
        elif version.startswith("<="):
            return "maximum_version"
        elif version.startswith("<"):
            return "less_than"
        elif "." in version and not any(op in version for op in ["<", ">", "~"]):
            return "exact_version"
        else:
            return "other_constraint"


def parse_arguments() -> argparse.Namespace:
    """Parse command line arguments."""
    parser = _create_argument_parser()
    _add_required_arguments(parser)
    _add_optional_arguments(parser)
    _add_utility_arguments(parser)
    
    return parser.parse_args()

def _create_argument_parser() -> argparse.ArgumentParser:
    """Create the base argument parser with description and examples."""
    return argparse.ArgumentParser(
        prog="utms",
        description=f"Universal Terraform Module Scanner (UTMS) v{__version__} - Scan source repositories for Terraform module references",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""
Authentication Methods (tried in order):
  1. --token argument  
  2. Environment variables (provider-specific)
  3. macOS Keychain
  4. Interactive prompt

Output:
  JSON files are automatically generated for each source in the 'results/' directory.
  Console output shows a summary of findings.

Examples:
  utms --source azure-devops --organization my-organization
  utms --source github --organization my-github-org  
  utms --source azure-devops --organization my-org --projects project1,project2
  utms --source github --organization my-org --repositories repo1,repo2
  utms --source azure-devops --organization my-org --clean --debug
        """
    )

def _add_required_arguments(parser: argparse.ArgumentParser) -> None:
    """Add required command line arguments."""
    parser.add_argument(
        "--source",
        required=True,
        choices=[e.value for e in SourceType],
        help="Source type to scan (azure-devops, github)"
    )
    
    parser.add_argument(
        "--organization", 
        required=True,
        help="Organization name (Azure DevOps organization or GitHub organization/user)"
    )
    
    parser.add_argument(
        "--token",
        help="Authentication token (overrides auto-detection)"
    )

def _add_optional_arguments(parser: argparse.ArgumentParser) -> None:
    """Add optional filtering and configuration arguments."""
    parser.add_argument(
        "--projects",
        help="Filter by specific projects (Azure DevOps only). Use comma-separated list for multiple"
    )
    
    parser.add_argument(
        "--repositories", 
        help="Filter by specific repositories (GitHub only). Use comma-separated list for multiple"
    )
    
    parser.add_argument(
        "--clean",
        action="store_true",
        help="Clean existing source JSON files before generating new ones"
    )
    
    parser.add_argument(
        "--debug",
        action="store_true", 
        help="Enable debug output"
    )

def _add_utility_arguments(parser: argparse.ArgumentParser) -> None:
