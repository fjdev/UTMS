def execute_main_scanning_process(args, repositories: List[Repository], repo_scanner: RepositoryScanner, results_manager: ResultsManager) -> int:
    """Execute the main scanning process and generate reports."""
    from datetime import datetime
    
    # Initialize scan summary
    summary = ScanSummary(
        organization=args.organization,
        source_type=SourceType(args.source),
        scan_timestamp=datetime.now().isoformat(),
        total_repositories=len(repositories)
    )
    
    safe_print("🔍 Starting Terraform module scanning...")
    safe_print(f"📊 Progress: {format_progress(0, len(repositories))}")
    
    start_time = datetime.now()
    all_results = []
    
    # Execute scanning based on processing mode
    if repo_scanner.use_concurrent_processing and len(repositories) > 1:
        all_results = execute_concurrent_scanning_workflow(args, repositories, repo_scanner, start_time)
    else:
        all_results = execute_sequential_scanning_workflow(args, repositories, repo_scanner, start_time)
    
    safe_print()  # Empty line after progress completion
    
    # Update summary with all results
    for result in all_results:
        summary.add_scan_result(result)
    
    # Generate and display final report
    generate_final_report(args, summary, all_results, start_time, results_manager)
    
    return 0


def execute_concurrent_scanning_workflow(args, repositories: List[Repository], repo_scanner: RepositoryScanner, start_time) -> List[ScanResult]:
    """Execute the concurrent scanning workflow."""
    from datetime import datetime
    
    def progress_callback(completed: int, total: int, result: ScanResult):
        progress_pct = (completed / total) * UTMSConfig.PERCENTAGE_MULTIPLIER
        elapsed = (datetime.now() - start_time).total_seconds()
        eta_per_repo = elapsed / completed if completed > 0 else 0
        remaining_repos = total - completed
        eta_remaining = eta_per_repo * remaining_repos if remaining_repos > 0 else 0
        
        progress_info = format_progress(completed, total, "📊 ")
        eta_info = f"ETA: {format_duration(eta_remaining)}" if eta_remaining > 0 else "Almost done!"
        
        modules_found = result.registry_modules_found if result else 0
        safe_print(f"{progress_info} {eta_info}")
        safe_print(f"[{completed}/{total}] Completed: {result.repository_name} - {modules_found} modules")
    
    return repo_scanner.scan_repositories_concurrent(repositories, args.organization, 
                                                   repo_scanner.auth_manager.get_token(SourceType.AZURE_DEVOPS, args.organization), progress_callback)


def execute_sequential_scanning_workflow(args, repositories: List[Repository], repo_scanner: RepositoryScanner, start_time) -> List[ScanResult]:
    """Execute the sequential scanning workflow."""
    from datetime import datetime
    
    all_results = []
    
    for i, repository in enumerate(repositories, 1):
        elapsed = (datetime.now() - start_time).total_seconds()
        eta_per_repo = elapsed / i if i > 0 else 0
        remaining_repos = len(repositories) - i
        eta_remaining = eta_per_repo * remaining_repos
        
        progress_info = format_progress(i, len(repositories), "📊 ")
        eta_info = f"ETA: {format_duration(eta_remaining)}" if eta_remaining > 0 else "Almost done!"
        
        safe_print(f"\n{progress_info} {eta_info}")
        safe_print(f"[{i}/{len(repositories)}] Scanning: {repository.full_name}")
        
        try:
            result = repo_scanner.scan_repository(repository, args.organization, 
                                                repo_scanner.auth_manager.get_token(SourceType.AZURE_DEVOPS, args.organization))
            all_results.append(result)
            
            if not result.repository_accessible:
                safe_print(f"   🔒 Repository disabled or inaccessible")
            elif result.registry_modules_found > 0:
                safe_print(f"   📦 Found {result.registry_modules_found} registry modules in {result.total_files_scanned} files")
            else:
                safe_print(f"   📄 Scanned {result.total_files_scanned} files - no registry modules found")
        
        except Exception as e:
            logger.error(f"Error scanning repository {repository.full_name}: {e}")
            continue
    
    return all_results


def generate_final_report(args, summary: ScanSummary, all_results: List[ScanResult], start_time, results_manager: ResultsManager) -> None:
    """Generate and display the final scan report."""
    from datetime import datetime
    
    # Generate final report
    total_time = (datetime.now() - start_time).total_seconds()
    disabled_count = sum(1 for result in all_results if not result.repository_accessible)
    accessible_repos = summary.total_repositories - disabled_count
    
    # Pre-calculate version status counts for display if TMVS cross-reference is enabled
    tmvs_dir = getattr(args, 'cross_reference', None)
    if tmvs_dir:
        # Create temporary output data structure to calculate version status counts
        source_type = SourceType(args.source)
        temp_output_data = results_manager._build_output_data_structure(args.organization, source_type, summary, {})
        results_manager._add_detailed_repository_results(temp_output_data, all_results, results_manager._load_tmvs_data_for_enrichment(tmvs_dir))
        results_manager._calculate_version_status_counts(temp_output_data, summary)
    
    # Display basic scan summary
    detailed_results = temp_output_data.get("detailed_results", []) if tmvs_dir else []
    display_scan_summary(args, summary, total_time, accessible_repos, disabled_count, detailed_results)
    
    # Display performance metrics only in debug mode
    if args.debug:
        display_performance_metrics(total_time, all_results, summary)
    
    # Module statistics section removed per user request
    
    # Save results and show completion status
    save_and_display_results(args, summary, all_results, results_manager)


