@dataclass(frozen=True)
class ModuleReference:
    """Represents a Terraform module reference found in source code."""
    source: str
    local_name: str = ""  # The local name used to refer to this module instance
    version: Optional[str] = None
    file_path: str = ""
    line_number: int = 0
    project_name: str = ""
    repository_name: str = ""
    
    def __post_init__(self):
        """Validate module reference after initialization."""
        if not self.source:
            raise ValueError("Module source cannot be empty")
    
    @property
    def is_registry_module(self) -> bool:
        """Check if this is a Terraform Registry module."""
        # Skip local paths and various non-registry sources
        if (self.source.startswith(('./', '../', '/', '~')) or 
            self.source.startswith(('git::', 'hg::', 'http://', 'https://', 's3::', 'gcs::')) or
            'github.com' in self.source or 'bitbucket.org' in self.source):
            return False
        
        # Registry modules have format: namespace/name/provider or hostname/namespace/name/provider
        parts = self.source.split('/')
        
        # Must have exactly 3 parts (public registry) or 4 parts (private registry)
        if len(parts) == UTMSConfig.PUBLIC_REGISTRY_PARTS:
            return True  # namespace/name/provider format
        elif len(parts) == UTMSConfig.PRIVATE_REGISTRY_PARTS and '.' in parts[0]:
            return True  # hostname/namespace/name/provider format
        
        return False
    
    @property
    def namespace(self) -> Optional[str]:
        """Extract namespace from registry module source."""
        if not self.is_registry_module:
            return None
        parts = self.source.split('/')
        return parts[-UTMSConfig.PROVIDER_INDEX_OFFSET]  # Works for both 3-part and 4-part formats
    
    @property
    def name(self) -> Optional[str]:
        """Extract name from registry module source."""
        if not self.is_registry_module:
            return None
        parts = self.source.split('/')
        return parts[-UTMSConfig.NAME_INDEX_OFFSET]
    
    @property
    def provider(self) -> Optional[str]:
        """Extract provider from registry module source."""
        if not self.is_registry_module:
            return None
        parts = self.source.split('/')
        return parts[-1]
    
    @property
    def registry_hostname(self) -> Optional[str]:
        """Extract registry hostname (for private registries)."""
        if not self.is_registry_module:
            return None
        parts = self.source.split('/')
        if len(parts) == UTMSConfig.PRIVATE_REGISTRY_PARTS:
            return parts[0]
        return "registry.terraform.io"  # Default public registry


@dataclass  
class ScanResult:
    """Represents the results of scanning a source."""
    source_type: SourceType
    organization: str
    project_name: str = ""
    repository_name: str = ""
    total_files_scanned: int = 0
    total_modules_found: int = 0
    registry_modules_found: int = 0
    repository_accessible: bool = True
    modules: List[ModuleReference] = field(default_factory=list)
    scan_timestamp: str = field(default_factory=lambda: datetime.now().isoformat())
    
    def add_module(self, module_ref: ModuleReference):
        """Add a module reference to the results."""
        self.modules.append(module_ref)
        self.total_modules_found += 1
        if module_ref.is_registry_module:
            self.registry_modules_found += 1


class VersionConstraintResolver:
    """Resolves Terraform version constraints against available versions."""
    
    @staticmethod
    def parse_version(version_str: str) -> Tuple[int, int, int]:
        """Parse a semantic version string into (major, minor, patch) tuple."""
        # Remove 'v' prefix if present
        version_str = version_str.lstrip('v')
        
        # Handle pre-release and build metadata
        base_version = version_str.split('-')[0].split('+')[0]
        
        parts = base_version.split('.')
        if len(parts) < UTMSConfig.VERSION_COMPONENT_COUNT:
            # Pad with zeros if needed
            parts.extend(['0'] * (UTMSConfig.VERSION_COMPONENT_COUNT - len(parts)))
        
        try:
            return (int(parts[UTMSConfig.VERSION_MAJOR_INDEX]), 
                    int(parts[UTMSConfig.VERSION_MINOR_INDEX]), 
                    int(parts[UTMSConfig.VERSION_PATCH_INDEX]))
        except ValueError:
            raise ValueError(f"Invalid version format: {version_str}")
    
    @staticmethod
    def version_matches_constraint(version: str, constraint: str) -> bool:
        """Check if a version satisfies a constraint."""
        if not constraint or constraint == "*":
            return True
        
        constraint = constraint.strip()
        
        # Handle special "latest" constraint
        if constraint.lower() == "latest":
            return True  # "latest" matches all versions (will be filtered to actual latest in resolve_constraint)
        
        # Handle multiple constraints separated by commas
        if ',' in constraint:
            return all(VersionConstraintResolver.version_matches_constraint(version, c.strip()) 
                      for c in constraint.split(','))
        
        # Parse version or return False if invalid
        try:
            v_major, v_minor, v_patch = VersionConstraintResolver.parse_version(version)
        except ValueError:
            return False
        
        # Delegate to specific constraint checkers
        return VersionConstraintResolver._check_specific_constraint(constraint, v_major, v_minor, v_patch)
    
    @staticmethod
    def _check_specific_constraint(constraint: str, v_major: int, v_minor: int, v_patch: int) -> bool:
        """Check a specific constraint type against parsed version components."""
        # Exact version
        if constraint.startswith('=') or (not any(op in constraint for op in ['~>', '>=', '<=', '>', '<', '!='])):
            return VersionConstraintResolver._check_exact_constraint(constraint, v_major, v_minor, v_patch)
        
        # Pessimistic constraint (~>)
        if constraint.startswith('~>'):
            return VersionConstraintResolver._check_pessimistic_constraint(constraint, v_major, v_minor, v_patch)
        
        # Comparison constraints
        if constraint.startswith('>='):
            return VersionConstraintResolver._check_greater_equal_constraint(constraint, v_major, v_minor, v_patch)
        
        if constraint.startswith('<='):
            return VersionConstraintResolver._check_less_equal_constraint(constraint, v_major, v_minor, v_patch)
        
        if constraint.startswith('>') and not constraint.startswith('>='):
            return VersionConstraintResolver._check_greater_constraint(constraint, v_major, v_minor, v_patch)
        
        if constraint.startswith('<') and not constraint.startswith('<='):
            return VersionConstraintResolver._check_less_constraint(constraint, v_major, v_minor, v_patch)
        
        if constraint.startswith('!='):
            return VersionConstraintResolver._check_not_equal_constraint(constraint, v_major, v_minor, v_patch)
        
        return False
    
    @staticmethod
    def _check_exact_constraint(constraint: str, v_major: int, v_minor: int, v_patch: int) -> bool:
        """Check exact version constraint."""
        target_version = constraint.lstrip('=').strip()
        try:
            t_major, t_minor, t_patch = VersionConstraintResolver.parse_version(target_version)
            return (v_major, v_minor, v_patch) == (t_major, t_minor, t_patch)
        except ValueError:
            return False
    
    @staticmethod
    def _check_pessimistic_constraint(constraint: str, v_major: int, v_minor: int, v_patch: int) -> bool:
        """Check pessimistic constraint (~>)."""
        target_version = constraint[UTMSConfig.CONSTRAINT_OFFSET_PESSIMISTIC:].strip()
        try:
            # Parse the constraint version
            target_parts = target_version.lstrip('v').split('-')[0].split('+')[0].split('.')
            t_major, t_minor, t_patch = VersionConstraintResolver.parse_version(target_version)
            
            # Must be >= the target version
            if (v_major, v_minor, v_patch) < (t_major, t_minor, t_patch):
                return False
            
            if len(target_parts) == 1:
                # ~> 1 means >= 1.0.0, < 2.0.0 
                return v_major == t_major
            elif len(target_parts) == UTMSConfig.NAME_INDEX_OFFSET:
                # ~> 1.1 means >= 1.1.0, < 2.0.0
                return v_major == t_major
            else:
                # ~> 1.1.4 means >= 1.1.4, < 1.2.0
                return v_major == t_major and v_minor == t_minor
        except ValueError:
            return False
    
    @staticmethod
    def _check_greater_equal_constraint(constraint: str, v_major: int, v_minor: int, v_patch: int) -> bool:
        """Check greater than or equal constraint (>=)."""
        target_version = constraint[2:].strip()
        try:
            t_major, t_minor, t_patch = VersionConstraintResolver.parse_version(target_version)
            return (v_major, v_minor, v_patch) >= (t_major, t_minor, t_patch)
        except ValueError:
            return False
    
    @staticmethod
    def _check_less_equal_constraint(constraint: str, v_major: int, v_minor: int, v_patch: int) -> bool:
        """Check less than or equal constraint (<=)."""
        target_version = constraint[2:].strip()
        try:
            t_major, t_minor, t_patch = VersionConstraintResolver.parse_version(target_version)
            return (v_major, v_minor, v_patch) <= (t_major, t_minor, t_patch)
        except ValueError:
            return False
    
    @staticmethod
    def _check_greater_constraint(constraint: str, v_major: int, v_minor: int, v_patch: int) -> bool:
        """Check greater than constraint (>)."""
        target_version = constraint[1:].strip()
        try:
            t_major, t_minor, t_patch = VersionConstraintResolver.parse_version(target_version)
            return (v_major, v_minor, v_patch) > (t_major, t_minor, t_patch)
        except ValueError:
            return False
    
    @staticmethod
    def _check_less_constraint(constraint: str, v_major: int, v_minor: int, v_patch: int) -> bool:
        """Check less than constraint (<)."""
        target_version = constraint[1:].strip()
        try:
            t_major, t_minor, t_patch = VersionConstraintResolver.parse_version(target_version)
            return (v_major, v_minor, v_patch) < (t_major, t_minor, t_patch)
        except ValueError:
            return False
    
    @staticmethod
    def _check_not_equal_constraint(constraint: str, v_major: int, v_minor: int, v_patch: int) -> bool:
        """Check not equal constraint (!=)."""
        target_version = constraint[2:].strip()
        try:
            t_major, t_minor, t_patch = VersionConstraintResolver.parse_version(target_version)
            return (v_major, v_minor, v_patch) != (t_major, t_minor, t_patch)
        except ValueError:
            return True  # If we can't parse, assume it's not equal
    
    @staticmethod
    def resolve_constraint(constraint: str, available_versions: List[str]) -> Dict[str, any]:
        """
        Resolve a constraint against available versions.
        
        Returns:
            Dict with resolved_versions, latest_matching, and constraint_info
        """
        if not available_versions:
            return VersionConstraintResolver._create_empty_result(constraint)
        
        # Determine constraint type
        constraint_type = VersionConstraintResolver._determine_constraint_type(constraint)
        
        # Handle "latest" constraint specially
        if constraint.lower() == 'latest':
            return VersionConstraintResolver._resolve_latest_constraint(constraint, available_versions, constraint_type)
        
        # Find matching versions for other constraints
        matching_versions = VersionConstraintResolver._find_matching_versions(constraint, available_versions)
        
        # Sort and return results
        return VersionConstraintResolver._create_constraint_result(constraint, matching_versions, constraint_type)
    
    @staticmethod
    def _create_empty_result(constraint: str) -> Dict[str, any]:
        """Create empty result for when no versions are available."""
        return {
            'constraint': constraint,
            'resolved_versions': [],
            'latest_matching': None,
            'total_matching': 0,
            'constraint_type': 'unknown'
        }
    
    @staticmethod
    def _determine_constraint_type(constraint: str) -> str:
        """Determine the type of version constraint."""
        if constraint.lower() == 'latest':
            return 'latest'
        elif constraint.startswith('~>'):
            return 'pessimistic'
        elif constraint.startswith('>='):
            return 'minimum'
        elif constraint.startswith('<='):
            return 'maximum'
        elif constraint.startswith('>'):
            return 'greater_than'
        elif constraint.startswith('<'):
            return 'less_than'
        elif constraint.startswith('!='):
            return 'not_equal'
        elif ',' in constraint:
            return 'range'
        elif not constraint or constraint == "*":
            return 'any'
        else:
            return 'exact'
    
    @staticmethod
    def _resolve_latest_constraint(constraint: str, available_versions: List[str], constraint_type: str) -> Dict[str, any]:
        """Handle 'latest' constraint resolution."""
        try:
            sorted_versions = sorted(
                available_versions,
                key=lambda v: VersionConstraintResolver.parse_version(v),
                reverse=True
            )
            latest_version = sorted_versions[0] if sorted_versions else None
            return {
                'constraint': constraint,
                'resolved_versions': [latest_version] if latest_version else [],
                'latest_matching': latest_version,
                'total_matching': 1 if latest_version else 0,
                'constraint_type': constraint_type
            }
        except ValueError:
            # Fallback to string sorting if version parsing fails
            sorted_versions = sorted(available_versions, reverse=True)
            latest_version = sorted_versions[0] if sorted_versions else None
            return {
                'constraint': constraint,
                'resolved_versions': [latest_version] if latest_version else [],
                'latest_matching': latest_version,
                'total_matching': 1 if latest_version else 0,
                'constraint_type': constraint_type
            }
    
    @staticmethod
    def _find_matching_versions(constraint: str, available_versions: List[str]) -> List[str]:
        """Find versions that match the given constraint."""
        matching_versions = []
        for version in available_versions:
            if VersionConstraintResolver.version_matches_constraint(version, constraint):
                matching_versions.append(version)
        return matching_versions
    
    @staticmethod
    def _create_constraint_result(constraint: str, matching_versions: List[str], constraint_type: str) -> Dict[str, any]:
        """Create the final constraint resolution result."""
        # Sort versions (newest first)
        try:
            matching_versions.sort(
                key=lambda v: VersionConstraintResolver.parse_version(v),
                reverse=True
            )
        except ValueError:
            # Fallback to string sorting if version parsing fails
            matching_versions.sort(reverse=True)
        
        return {
            'constraint': constraint,
            'resolved_versions': matching_versions,
            'latest_matching': matching_versions[0] if matching_versions else None,
            'total_matching': len(matching_versions),
            'constraint_type': constraint_type
        }


class TerraformFileScanner:
    """Scans Terraform files for module references with caching."""
    
    def __init__(self):
        # Primary configuration files that can contain module blocks
        self.terraform_file_patterns = ['.tf', '.tf.json']
        
        # Variable files that should NOT be scanned (they don't contain module blocks)
        # .tfvars and .tfvars.json only contain variable assignments, not module declarations
        self.variable_file_patterns = ['.tfvars', '.tfvars.json', '.auto.tfvars', '.auto.tfvars.json']
        
        # Files and directories to ignore during scanning
        self.ignore_patterns = [
            '.terraform/',       # Terraform working directory
            '*.tfstate',         # State files
            '*.tfstate.backup',  # State backup files
            '.terraform.lock.hcl', # Dependency lock file
            '*.tfplan',          # Plan files
            'terraform.tfvars',  # Variable files (don't contain modules)
            'terraform.tfvars.json',
            '*.auto.tfvars',
            '*.auto.tfvars.json',
            'crash.log',         # Terraform crash logs
            '.terraformrc',      # CLI configuration
            'terraform.rc'       # CLI configuration (Windows)
        ]
        
        # Cache for compiled regex patterns (performance optimization)
        self._constraint_pattern_cache = {}
    
    def _is_valid_terraform_version_constraint(self, version_str: str) -> bool:
        """
        Check if a version string looks like a valid Terraform module version constraint.
        
        Valid constraints:
        - Semantic versions: "1.0.0", "2.1.3"
        - Version ranges: "~> 1.0", ">= 1.0.0", "< 2.0.0"
        - Complex constraints: ">= 1.0.0, < 2.0.0"
        
        Invalid (likely not module constraints):
        - Plain words: "latest", "stable", "production"
        - Non-semantic versions: "windows", "linux", "v1"
        """
        if not version_str:
            return False
            
        version_str = version_str.strip()
        
        # Check for common Terraform version constraint patterns
        constraint_patterns = [
            r'^~>\s*\d+(\.\d+)*',           # Pessimistic: ~> 1.0, ~> 1.2.3
            r'^>=\s*\d+(\.\d+)*',           # Greater than equal: >= 1.0.0
            r'^<=\s*\d+(\.\d+)*',           # Less than equal: <= 2.0.0
            r'^>\s*\d+(\.\d+)*',            # Greater than: > 1.0.0
            r'^<\s*\d+(\.\d+)*',            # Less than: < 2.0.0
            r'^!=\s*\d+(\.\d+)*',           # Not equal: != 1.0.0
            r'^=\s*\d+(\.\d+)*',            # Exact: = 1.0.0
            r'^\d+(\.\d+)*$',               # Simple version: 1.0.0, 1.2
            r'^\d+(\.\d+)*\s*,\s*',         # Complex constraints with commas
        ]
        
        import re
        for pattern in constraint_patterns:
            if re.match(pattern, version_str):
                return True
        
        # Reject common non-constraint values
        non_constraint_values = {
            'latest', 'stable', 'production', 'development', 'test', 'staging',
            'windows', 'linux', 'ubuntu', 'centos', 'rhel', 'debian',
            'server', 'desktop', 'core', 'standard', 'enterprise',
            'true', 'false', 'yes', 'no', 'enabled', 'disabled'
        }
        
        if version_str.lower() in non_constraint_values:
            return False
            
        return False
    
    def scan_content(self, content: str, file_path: str, project_name: str = "", repository_name: str = "") -> List[ModuleReference]:
        """
        Scan content of a Terraform file for module references.
        
        Args:
            content: File content to scan
            file_path: Path to the file being scanned
            project_name: Name of the project containing the file
            repository_name: Name of the repository containing the file
            
        Returns:
            List of module references found
        """
        modules = []
        
        if file_path.endswith('.tf.json'):
            modules.extend(self._scan_json_content(content, file_path, project_name, repository_name))
        else:
            modules.extend(self._scan_hcl_content(content, file_path, project_name, repository_name))
        
        return modules
    
    def _scan_hcl_content(self, content: str, file_path: str, project_name: str, repository_name: str) -> List[ModuleReference]:
        """Scan HCL (.tf) file content for module blocks."""
        modules = []
        lines = content.splitlines()
        
        in_module_block = False
        current_module = {}
        brace_count = 0
        
        for line_num, line in enumerate(lines, 1):
            stripped = line.strip()
            
            # Skip comments and empty lines
            if not stripped or stripped.startswith('#') or stripped.startswith('//'):
                continue
            
            # Check for start of module block
            if not in_module_block and stripped.startswith('module '):
                in_module_block = True
                current_module = self._extract_module_name(stripped, line_num)
                brace_count = 0
            
            if in_module_block:
                # Count braces to track block depth
                brace_count += line.count('{') - line.count('}')
                
                # Extract source and version
                current_module = self._extract_module_properties(line, current_module)
                
                # End of module block
                if brace_count <= 0 and '}' in line:
                    in_module_block = False
                    
                    # Create module reference if we found a source
                    module_ref = self._create_module_reference(current_module, file_path, project_name, repository_name)
                    if module_ref:
                        modules.append(module_ref)
                    
                    current_module = {}
        
        return modules
    
    def _extract_module_name(self, line: str, line_number: int) -> dict:
        """Extract module local name from module declaration line."""
        module_info = {'line_number': line_number}
        
        try:
            # Find the local name between quotes
            import re
            match = re.search(r'module\s+"([^"]+)"', line)
            if match:
                module_info['local_name'] = match.group(1)
            else:
                # Try single quotes as fallback
                match = re.search(r"module\s+'([^']+)'", line)
                if match:
                    module_info['local_name'] = match.group(1)
                else:
                    module_info['local_name'] = "unknown"
        except Exception:
            module_info['local_name'] = "unknown"
        
        return module_info
    
    def _extract_module_properties(self, line: str, current_module: dict) -> dict:
        """Extract source and version properties from module block line."""
        if '=' in line:
            key, value = line.split('=', 1)
            key = key.strip()
            value = value.strip().strip('"').strip("'")
            
            if key == 'source':
                current_module['source'] = value
            elif key == 'version' and self._is_valid_terraform_version_constraint(value):
                current_module['version'] = value
        
        return current_module
    
    def _create_module_reference(self, module_data: dict, file_path: str, project_name: str, repository_name: str) -> Optional[ModuleReference]:
        """Create a ModuleReference from extracted module data."""
        if 'source' not in module_data:
            return None
        
        module_ref = ModuleReference(
            source=module_data['source'],
            local_name=module_data.get('local_name', 'unknown'),
            version=module_data.get('version'),
            file_path=file_path,
            line_number=module_data['line_number'],
            project_name=project_name,
            repository_name=repository_name
        )
        
        # Only include valid Terraform Registry modules
        if module_ref.is_registry_module and self.validate_module_reference(module_ref):
            return module_ref
        
        return None
    
    def _scan_json_content(self, content: str, file_path: str, project_name: str, repository_name: str) -> List[ModuleReference]:
        """Scan JSON (.tf.json) file content for module blocks."""
        modules = []
        
        try:
            import json
            data = json.loads(content)
            
            # Look for module blocks in JSON structure
            if 'module' in data and isinstance(data['module'], dict):
                for module_name, module_config in data['module'].items():
                    if isinstance(module_config, dict):
                        source = module_config.get('source')
                        version = module_config.get('version')
                        
                        # Only include version if it looks like a valid constraint
                        if version and not self._is_valid_terraform_version_constraint(version):
                            version = None
                        
                        if source:
                            module_ref = ModuleReference(
                                source=source,
                                local_name=module_name,  # In JSON, the key is the local name
                                version=version,
                                file_path=file_path,
                                line_number=1,  # JSON doesn't have meaningful line numbers for blocks
                                project_name=project_name,
                                repository_name=repository_name
                            )
                            
                            # Only include valid Terraform Registry modules
                            if module_ref.is_registry_module and self.validate_module_reference(module_ref):
                                modules.append(module_ref)
        
        except (json.JSONDecodeError, KeyError, TypeError) as e:
            logger.debug(f"Error parsing JSON file {file_path}: {e}")
        
        return modules
    
    def is_terraform_file(self, file_path: str) -> bool:
        """Check if a file is a Terraform file we should scan."""
        return any(file_path.endswith(pattern) for pattern in self.terraform_file_patterns)
    
    def should_ignore_path(self, file_path: str) -> bool:
        """Check if a file path should be ignored during scanning."""
        import fnmatch
        
        for pattern in self.ignore_patterns:
            if fnmatch.fnmatch(file_path, pattern) or pattern in file_path:
                return True
        return False
    
    def is_variable_file(self, file_path: str) -> bool:
        """Check if a file is a variable file (shouldn't be scanned for modules)."""
        return any(file_path.endswith(pattern) for pattern in self.variable_file_patterns)
    
    def validate_module_reference(self, module_ref: ModuleReference) -> bool:
        """Validate that a module reference is correctly parsed."""
        if not module_ref.source:
            return False
        
        # For registry modules, validate the format
        if module_ref.is_registry_module:
            parts = module_ref.source.split('/')
            
            # Must have valid namespace, name, and provider
            if len(parts) == 3:
                namespace, name, provider = parts
            elif len(parts) == 4:
                hostname, namespace, name, provider = parts
                # Hostname should look like a domain
                if '.' not in hostname:
                    return False
            else:
                return False
            
            # Basic validation of parts (no empty strings, reasonable characters)
            for part in [namespace, name, provider]:
                if not part or not part.replace('-', '').replace('_', '').isalnum():
                    return False
        
        return True


# Repository Discovery and Scanning Classes

@dataclass
class Repository:
    """Represents a source control repository."""
    name: str
    id: str
    project_name: str = ""
    project_id: str = ""
    default_branch: str = "main"
    web_url: str = ""
    clone_url: str = ""
    size_kb: int = 0
    source_type: SourceType = SourceType.AZURE_DEVOPS
    
    @property
    def full_name(self) -> str:
        """Get full repository name including project."""
        if self.project_name:
            return f"{self.project_name}/{self.name}"
        return self.name


class RepositoryDiscovery(BaseAPIClient):
    """Discovers and lists repositories from source control providers."""
    
    def __init__(self, source_type: SourceType, auth_manager: 'AuthenticationManager'):
        self.source_type = source_type
        self.auth_manager = auth_manager
    
    def discover_repositories(self, organization: str, token: str, project_filter: List[str] = None) -> List[Repository]:
        """
        Discover all accessible repositories in the organization.
        
        Args:
            organization: Organization name
            token: Authentication token
            project_filter: Optional list of specific projects to scan
            
        Returns:
            List of Repository objects
        """
        if self.source_type == SourceType.AZURE_DEVOPS:
            return self._discover_azure_devops_repositories(organization, token, project_filter)
        elif self.source_type == SourceType.GITHUB:
            return self._discover_github_repositories(organization, token)
        else:
            raise ValueError(f"Unsupported source type: {self.source_type}")
    
    def _discover_azure_devops_repositories(self, organization: str, token: str, project_filter: List[str] = None) -> List[Repository]:
        """Discover Azure DevOps repositories."""
        repositories = []
        headers = self.auth_manager.get_headers(self.source_type, token)
        
        try:
            # First, get all projects
            projects_url = f'https://dev.azure.com/{organization}/_apis/projects?api-version=6.0'
            projects = self._make_api_request(projects_url, headers)
            
            for project in projects.get('value', []):
                project_name = project['name']
                project_id = project['id']
                
                # Apply project filter if specified
                if project_filter and project_name not in project_filter:
                    logger.debug(f"Skipping project {project_name} (not in filter)")
                    continue
                
                logger.info(f"📁 Discovering repositories in project: {project_name}")
                
                # Get repositories for this project
                repos_url = f'https://dev.azure.com/{organization}/{project_id}/_apis/git/repositories?api-version=6.0'
                repos_data = self._make_api_request(repos_url, headers)
                
                for repo in repos_data.get('value', []):
                    repository = Repository(
                        name=repo['name'],
                        id=repo['id'],
                        project_name=project_name,
                        project_id=project_id,
                        default_branch=repo.get('defaultBranch', 'refs/heads/main').replace('refs/heads/', ''),
                        web_url=repo.get('webUrl', ''),
                        clone_url=repo.get('remoteUrl', ''),
                        size_kb=repo.get('size', 0),
                        source_type=self.source_type
                    )
                    repositories.append(repository)
                    logger.debug(f"  📂 Found repository: {repo['name']}")
        
        except Exception as e:
            logger.error(f"Error discovering Azure DevOps repositories: {e}")
            raise
        
        logger.info(f"✅ Discovered {len(repositories)} repositories across {len(set(r.project_name for r in repositories))} projects")
        return repositories
    
    def _discover_github_repositories(self, organization: str, token: str) -> List[Repository]:
        """Discover GitHub repositories (placeholder for future implementation)."""
        # TODO: Implement GitHub repository discovery
        logger.warning("🚧 GitHub repository discovery not yet implemented")
        return []


class RepositoryScanner(BaseAPIClient):
    """Scans repositories for Terraform files and module references."""
    
    def __init__(self, source_type: SourceType, auth_manager: 'AuthenticationManager', file_scanner: TerraformFileScanner):
        self.source_type = source_type
        self.auth_manager = auth_manager
        self.file_scanner = file_scanner
        self.max_file_size_bytes = UTMSConfig.MAX_FILE_SIZE_BYTES
        self.use_concurrent_processing = True  # Enable concurrent processing by default
        self._scan_cache = {}  # Cache for API responses
        self._cache_lock = threading.Lock()
    
    def scan_repositories_concurrent(self, repositories: List[Repository], organization: str, token: str, progress_callback=None) -> List[ScanResult]:
        """
        Scan multiple repositories concurrently for improved performance.
        
        Args:
            repositories: List of repositories to scan
            organization: Organization name
            token: Authentication token
            progress_callback: Optional callback for progress updates
            
        Returns:
            List of ScanResult objects
        """
        logger.info(f"🚀 Starting concurrent repository scanning ({UTMSConfig.MAX_CONCURRENT_REPOS} workers)")
        
        all_results = []
        completed_count = 0
        
        # Process repositories in batches to control memory usage
        batch_size = self._calculate_batch_size()
        
        for batch_start in range(0, len(repositories), batch_size):
            batch_end = min(batch_start + batch_size, len(repositories))
            batch_repos = repositories[batch_start:batch_end]
            
            logger.debug(f"Processing batch {batch_start//batch_size + 1}: repositories {batch_start+1}-{batch_end}")
            
            batch_results, completed_count = self._process_repository_batch(
                batch_repos, organization, token, progress_callback, 
                completed_count, len(repositories)
            )
            all_results.extend(batch_results)
        
        logger.info(f"✅ Concurrent scanning completed. Processed {len(repositories)} repositories")
        return all_results
    
    def _calculate_batch_size(self) -> int:
        """Calculate optimal batch size for repository processing."""
        return UTMSConfig.REPOSITORY_BATCH_SIZE * UTMSConfig.MAX_CONCURRENT_REPOS
    
    def _process_repository_batch(self, batch_repos: List[Repository], organization: str, 
                                token: str, progress_callback, completed_count: int, 
                                total_repos: int) -> Tuple[List[ScanResult], int]:
        """Process a batch of repositories concurrently."""
        batch_results = []
        
        # Scan batch concurrently
        with ThreadPoolExecutor(max_workers=UTMSConfig.MAX_CONCURRENT_REPOS) as executor:
            # Submit all repositories in this batch
            future_to_repo = {
                executor.submit(self.scan_repository, repo, organization, token): repo 
                for repo in batch_repos
            }
            
            # Collect results as they complete
            for future in as_completed(future_to_repo):
                repo = future_to_repo[future]
                completed_count += 1
                
                try:
                    result = future.result()
                    batch_results.append(result)
                    
                    # Call progress callback if provided
                    if progress_callback:
                        progress_callback(completed_count, total_repos, result)
                        
                except Exception as e:
                    logger.error(f"Error scanning repository {repo.full_name}: {e}")
                    # Create failed result
                    failed_result = self._create_failed_result(organization, repo)
                    batch_results.append(failed_result)
        
        return batch_results, completed_count
    
    def _create_failed_result(self, organization: str, repo: Repository) -> ScanResult:
        """Create a failed scan result for a repository."""
        failed_result = ScanResult(
            source_type=self.source_type,
            organization=organization,
            project_name=repo.project_name,
            repository_name=repo.name
        )
        failed_result.repository_accessible = False
        return failed_result
    
    @lru_cache(maxsize=UTMSConfig.CACHE_SIZE_LIMIT)
    def _cached_api_request(self, url: str, headers_tuple: tuple) -> dict:
        """
        Make cached API request to avoid redundant calls.
        
        Args:
            url: API endpoint URL
            headers_tuple: Headers as tuple (for hashability)
            
        Returns:
            API response data
        """
        # Convert tuple back to dict for the actual request
        headers = dict(headers_tuple)
        return self._make_api_request(url, headers)
    
    def _make_cached_request(self, url: str, headers: dict) -> dict:
        """
        Make an API request with caching support.
        
        Args:
            url: API endpoint URL
            headers: Request headers
            
        Returns:
            API response data
        """
        # Convert headers to tuple for caching (tuples are hashable)
        headers_tuple = tuple(sorted(headers.items()))
        return self._cached_api_request(url, headers_tuple)
    
    def scan_repository(self, repository: Repository, organization: str, token: str) -> ScanResult:
        """
        Scan a single repository for Terraform module references.
        
        Args:
            repository: Repository to scan
            organization: Organization name
            token: Authentication token
            
        Returns:
            ScanResult with discovered modules
        """
        logger.info(f"🔍 Scanning repository: {repository.full_name}")
        
        result = ScanResult(
            source_type=self.source_type,
            organization=organization,
            project_name=repository.project_name,
            repository_name=repository.name
        )
        
        try:
            # Get file tree and validate repository access
            terraform_files = self._get_and_validate_files(repository, organization, token, result)
            if not result.repository_accessible:
                return result
            
            # Scan each file for module references
            self._scan_terraform_files(repository, organization, token, terraform_files, result)
        
        except Exception as e:
            logger.error(f"Error scanning repository {repository.full_name}: {e}")
        
        logger.info(f"  ✅ Found {result.registry_modules_found} registry modules in {repository.name}")
        return result
    
    def _get_and_validate_files(self, repository: Repository, organization: str, token: str, result: ScanResult) -> List[dict]:
        """Get terraform files from repository and validate access."""
        # Get file tree from repository
        terraform_files = self._discover_terraform_files(repository, organization, token)
        result.total_files_scanned = len(terraform_files)
        
        logger.info(f"  📄 Found {len(terraform_files)} Terraform files")
        
        # Check if repository is accessible (if no files found, it might be disabled)
        if len(terraform_files) == 0:
            # Additional check to see if repository access failed
            test_access = self._test_repository_access(repository, organization, token)
            if not test_access:
                result.repository_accessible = False
                logger.info(f"  🔒 Repository appears to be disabled or inaccessible")
        
        return terraform_files
    
    def _scan_terraform_files(self, repository: Repository, organization: str, token: str, 
                             terraform_files: List[dict], result: ScanResult) -> None:
        """Scan each terraform file for module references."""
        # Use concurrent processing for larger file sets
        if self.use_concurrent_processing and len(terraform_files) > UTMSConfig.MIN_FILES_FOR_CONCURRENT_PROCESSING:
            self._scan_terraform_files_concurrent(repository, organization, token, terraform_files, result)
        else:
            self._scan_terraform_files_sequential(repository, organization, token, terraform_files, result)
    
    def _scan_terraform_files_sequential(self, repository: Repository, organization: str, token: str, 
                                       terraform_files: List[dict], result: ScanResult) -> None:
        """Scan terraform files sequentially (original method)."""
        for file_info in terraform_files:
            try:
                logger.debug(f"    🔍 Scanning file: {file_info['path']} ({file_info.get('size', 0)} bytes)")
                file_content = self._get_file_content(repository, file_info, organization, token)
                
                if file_content:
                    self._process_file_content(file_info, file_content, repository, result)
                else:
                    logger.debug(f"    ❌ Could not retrieve file content")
            
            except Exception as e:
                logger.warning(f"    ⚠️ Error scanning {file_info['path']}: {e}")
                continue
    
    def _scan_terraform_files_concurrent(self, repository: Repository, organization: str, token: str, 
                                       terraform_files: List[dict], result: ScanResult) -> None:
        """Scan terraform files concurrently for improved performance."""
        logger.debug(f"    🚀 Using concurrent file processing ({UTMSConfig.MAX_CONCURRENT_FILES} workers)")
        
        with concurrent.futures.ThreadPoolExecutor(max_workers=UTMSConfig.MAX_CONCURRENT_FILES) as executor:
            # Create futures for file processing
            future_to_file = {
                executor.submit(self._process_single_file, repository, file_info, organization, token): file_info
                for file_info in terraform_files
            }
            
            # Collect results as they complete
            for future in concurrent.futures.as_completed(future_to_file):
                file_info = future_to_file[future]
                try:
                    modules = future.result()
                    if modules:
                        for module in modules:
                            result.add_module(module)
                        logger.info(f"    📦 {file_info['path']}: {len(modules)} modules")
                except Exception as e:
                    logger.warning(f"    ⚠️ Error processing file {file_info['path']}: {e}")
    
    def _process_single_file(self, repository: Repository, file_info: dict, organization: str, token: str) -> List['TerraformModule']:
        """Process a single file and return discovered modules (for concurrent processing)."""
        logger.debug(f"    🔍 Scanning file: {file_info['path']} ({file_info.get('size', 0)} bytes)")
        file_content = self._get_file_content(repository, file_info, organization, token)
        
        if file_content:
            logger.debug(f"    📖 Retrieved content: {len(file_content)} characters")
            
            # Debug: Show first characters of content
            preview = file_content[:UTMSConfig.CONTENT_PREVIEW_LENGTH].replace('\n', '\\n').replace('\r', '\\r')
            logger.debug(f"    👀 Content preview: {preview}")
            
            # Check if content contains module blocks
            if 'module ' in file_content:
                logger.debug(f"    🎯 File contains 'module ' blocks")
            else:
                logger.debug(f"    ➡️  File does not contain module blocks")
            
            modules = self.file_scanner.scan_content(
                content=file_content,
                file_path=file_info['path'],
                project_name=repository.project_name,
                repository_name=repository.name
            )
            
            logger.debug(f"    📊 Scan result: {len(modules)} modules found")
            return modules
        else:
            logger.debug(f"    ❌ Could not retrieve file content")
            return []
    
    def _process_file_content(self, file_info: dict, file_content: str, repository: Repository, result: ScanResult) -> None:
        """Process the content of a single terraform file."""
        logger.debug(f"    📖 Retrieved content: {len(file_content)} characters")
        
        # Debug: Show first characters of content
        preview = file_content[:UTMSConfig.CONTENT_PREVIEW_LENGTH].replace('\n', '\\n').replace('\r', '\\r')
        logger.debug(f"    👀 Content preview: {preview}")
        
        # Check if content contains module blocks
        if 'module ' in file_content:
            logger.debug(f"    🎯 File contains 'module ' blocks")
        else:
            logger.debug(f"    ➡️  File does not contain module blocks")
        
        modules = self.file_scanner.scan_content(
            content=file_content,
            file_path=file_info['path'],
            project_name=repository.project_name,
            repository_name=repository.name
        )
        
        logger.debug(f"    📊 Scan result: {len(modules)} modules found")
        
        for module in modules:
            logger.debug(f"    ✅ Module '{module.local_name}': {module.source} (registry: {module.is_registry_module})")
            result.add_module(module)
        
        if modules:
            logger.info(f"    📦 {file_info['path']}: {len(modules)} modules")
    
    def _discover_terraform_files(self, repository: Repository, organization: str, token: str) -> List[dict]:
        """Discover all Terraform files in the repository."""
        terraform_files = []
        headers = self.auth_manager.get_headers(self.source_type, token)
        
        try:
            if self.source_type == SourceType.AZURE_DEVOPS:
                # Get file tree from Azure DevOps
                items_url = f'https://dev.azure.com/{organization}/{repository.project_id}/_apis/git/repositories/{repository.id}/items?recursionLevel=Full&api-version=6.0'
                items_data = self._make_api_request(items_url, headers)
                
                for item in items_data.get('value', []):
                    if item.get('gitObjectType') == 'blob':  # It's a file
                        file_path = item['path']
                        
                        # Check if it's a Terraform file and not ignored
                        if (self.file_scanner.is_terraform_file(file_path) and 
                            not self.file_scanner.should_ignore_path(file_path) and
                            not self.file_scanner.is_variable_file(file_path)):
                            
                            terraform_files.append({
                                'path': file_path,
                                'objectId': item['objectId'],
                                'size': item.get('size', 0)
                            })
        
        except Exception as e:
            # Parse Azure DevOps specific errors for better user experience
            error_message = str(e)
            if "TF401019" in error_message and "does not exist or you do not have permissions" in error_message:
                logger.debug(f"Repository {repository.full_name} is disabled or inaccessible (TF401019)")
                return []  # Return empty list to indicate no files accessible
            elif str(UTMSConfig.HTTP_NOT_FOUND) in error_message:
                logger.debug(f"Repository {repository.full_name} not found or access denied ({UTMSConfig.HTTP_NOT_FOUND})")
                return []  # Return empty list to indicate no files accessible
            else:
                logger.warning(f"Error discovering files in {repository.full_name}: {e}")
        
        return terraform_files
    
    def _test_repository_access(self, repository: Repository, organization: str, token: str) -> bool:
        """Test if repository is accessible by attempting a basic API call."""
        headers = self.auth_manager.get_headers(self.source_type, token)
        
        try:
            if self.source_type == SourceType.AZURE_DEVOPS:
                # Try to get repository info (lightweight call)
                repo_url = f'https://dev.azure.com/{organization}/{repository.project_id}/_apis/git/repositories/{repository.id}?api-version=6.0'
                self._make_api_request(repo_url, headers)
                return True
        except Exception as e:
            error_message = str(e)
            if "TF401019" in error_message or str(UTMSConfig.HTTP_NOT_FOUND) in error_message:
                return False
            # For other errors, assume accessible (might be temporary issue)
            return True
        
        return True
    
    def _get_file_content(self, repository: Repository, file_info: dict, organization: str, token: str) -> Optional[str]:
        """Get the content of a specific file."""
        file_size = file_info.get('size', 0)
        
        # Skip files that are too large
        if file_size > self.max_file_size_bytes:
            logger.debug(f"Skipping large file: {file_info['path']} ({file_size} bytes)")
            return None
        
        # Use streaming for larger files to improve memory efficiency
        if file_size > UTMSConfig.MIN_FILE_SIZE_FOR_STREAMING:
            return self._get_file_content_streaming(repository, file_info, organization, token)
        else:
            return self._get_file_content_direct(repository, file_info, organization, token)
    
    def _get_file_content_direct(self, repository: Repository, file_info: dict, organization: str, token: str) -> Optional[str]:
        """Get file content directly (for smaller files)."""
        headers = self.auth_manager.get_headers(self.source_type, token)
        
        try:
            if self.source_type == SourceType.AZURE_DEVOPS:
                # Get file content from Azure DevOps using the correct API endpoint
                # We need to add &$format=text to get actual content instead of JSON metadata
                import urllib.parse
                encoded_path = urllib.parse.quote(file_info['path'])
                content_url = f"https://dev.azure.com/{organization}/{repository.project_id}/_apis/git/repositories/{repository.id}/items?path={encoded_path}&$format=text&api-version=6.0"
                
                import urllib.request
                req = urllib.request.Request(content_url, headers=headers)
                with urllib.request.urlopen(req, timeout=UTMSConfig.API_TIMEOUT_SECONDS) as response:
                    if response.status == UTMSConfig.HTTP_OK:
                        return response.read().decode('utf-8', errors='ignore')
        
        except Exception as e:
            logger.debug(f"Error getting file content for {file_info['path']}: {e}")
        
        return None
    
    def _get_file_content_streaming(self, repository: Repository, file_info: dict, organization: str, token: str) -> Optional[str]:
        """Get file content using streaming (for larger files)."""
        headers = self.auth_manager.get_headers(self.source_type, token)
        
        try:
            if self.source_type == SourceType.AZURE_DEVOPS:
                import urllib.parse
                encoded_path = urllib.parse.quote(file_info['path'])
                content_url = f"https://dev.azure.com/{organization}/{repository.project_id}/_apis/git/repositories/{repository.id}/items?path={encoded_path}&$format=text&api-version=6.0"
                
                import urllib.request
                req = urllib.request.Request(content_url, headers=headers)
                
                content_chunks = []
                with urllib.request.urlopen(req, timeout=UTMSConfig.API_TIMEOUT_SECONDS) as response:
                    if response.status == UTMSConfig.HTTP_OK:
                        # Stream content in chunks
                        while True:
                            chunk = response.read(UTMSConfig.STREAM_CHUNK_SIZE)
                            if not chunk:
                                break
                            content_chunks.append(chunk)
                        
                        # Decode all chunks together
                        return b''.join(content_chunks).decode('utf-8', errors='ignore')
        
        except Exception as e:
            logger.debug(f"Error streaming file content for {file_info['path']}: {e}")
        
        return None
    
    def _make_api_request(self, url: str, headers: dict) -> dict:
        """Make an authenticated API request."""
        import urllib.request
        import urllib.error
        import json
        
        try:
            req = urllib.request.Request(url, headers=headers)
            with urllib.request.urlopen(req, timeout=UTMSConfig.API_TIMEOUT_SECONDS) as response:
                if response.status == UTMSConfig.HTTP_OK:
                    return json.loads(response.read().decode())
                else:
                    raise Exception(f"API request failed with status {response.status}")
        except urllib.error.HTTPError as e:
            error_body = e.read().decode() if e.fp else "No error details"
            raise Exception(f"HTTP {e.code}: {error_body}")
        except Exception as e:
            raise Exception(f"API request failed: {e}")


class AuthenticationProvider(ABC):
    """Abstract base class for authentication providers."""
    
    @abstractmethod
    def get_token(self) -> Optional[str]:
        """Get authentication token."""
        pass
    
    @abstractmethod 
    def get_name(self) -> str:
        """Get provider name for logging."""
        pass


class EnvironmentAuthProvider(AuthenticationProvider):
    """Get token from environment variables."""
    
    def __init__(self, env_var_names: List[str]):
        self.env_var_names = env_var_names
    
    def get_token(self) -> Optional[str]:
        """Check environment variables for token."""
        for env_var in self.env_var_names:
            token = os.getenv(env_var)
            if token and token.strip():
                logger.debug(f"Found token in environment variable: {env_var}")
                return token.strip()
        return None
    
    def get_name(self) -> str:
        """Get provider name."""
        return "environment variables"


class KeychainAuthProvider(AuthenticationProvider):
    """Get token from macOS Keychain."""
    
    def __init__(self, service_name: str, account_name: str):
        self.service_name = service_name
        self.account_name = account_name
    
    def get_token(self) -> Optional[str]:
        """Retrieve token from macOS Keychain."""
        try:
            import subprocess
            result = subprocess.run([
                'security', 'find-generic-password',
                '-s', self.service_name,
                '-a', self.account_name,
                '-w'
            ], capture_output=True, text=True, check=True, timeout=UTMSConfig.TOKEN_VALIDATION_TIMEOUT)
            
            token = result.stdout.strip()
            if token:
                logger.debug(f"Found token in keychain: {self.service_name}")
                return token
        except (subprocess.CalledProcessError, subprocess.TimeoutExpired, FileNotFoundError):
            logger.debug(f"Could not retrieve token from keychain: {self.service_name}")
        except Exception as e:
            logger.debug(f"Keychain access failed: {e}")
        return None
    
    def get_name(self) -> str:
        """Get provider name."""
        return "macOS Keychain"


class InteractiveAuthProvider(AuthenticationProvider):
    """Get token through interactive prompt."""
    
    def __init__(self, service_name: str, organization: str = ""):
        self.service_name = service_name
        self.organization = organization
    
    def get_token(self) -> Optional[str]:
        """Prompt user for token securely."""
        safe_print(f"\n🔐 {self.service_name} authentication required.")
        if self.organization:
            safe_print(f"   Organization: {self.organization}")
        self._show_instructions()
        safe_print()
        
        try:
            import getpass
            token = getpass.getpass(f"Enter your {self.service_name} PAT: ").strip()
            if not token:
                logger.warning("No token provided")
                return None
            
            # Offer to save to keychain on macOS
            if sys.platform == 'darwin' and self.organization:
                self._offer_keychain_save(token)
            
            return token
        except KeyboardInterrupt:
            safe_print("\n❌ Authentication cancelled by user")
            return None
        except Exception as e:
            logger.error(f"Error during interactive authentication: {e}")
            return None
    
    def _show_instructions(self):
        """Show service-specific instructions."""
        # Override in subclasses for specific instructions
        safe_print("   Please provide your Personal Access Token (PAT)")
    
    def _offer_keychain_save(self, token: str):
        """Offer to save token to keychain."""
        # Override in subclasses for specific keychain handling
        pass
    
    def get_name(self) -> str:
        """Get provider name."""
        return "interactive prompt"


