def safe_print(*args, **kwargs):
    """Print function that handles BrokenPipeError gracefully."""
    try:
        print(*args, **kwargs)
    except BrokenPipeError:
        # Silence broken pipe errors (e.g., when piping to head)
        try:
            sys.stdout.close()
        except OSError:
            pass
        sys.exit(0)


def format_progress(current: int, total: int, prefix: str = "") -> str:
    """Format a progress indicator string."""
    if total == 0:
        return f"{prefix}[0/0]"
    
    percentage = (current / total) * UTMSConfig.PERCENTAGE_MULTIPLIER
    bar_length = UTMSConfig.PROGRESS_BAR_LENGTH
    filled_length = int(bar_length * current // total)
    bar = '█' * filled_length + '░' * (bar_length - filled_length)
    
    return f"{prefix}[{current}/{total}] {bar} {percentage:.1f}%"


def format_duration(seconds: float) -> str:
    """Format duration in human-readable format."""
    if seconds < UTMSConfig.SECONDS_IN_MINUTE:
        return f"{seconds:.1f}s"
    elif seconds < UTMSConfig.SECONDS_IN_HOUR:
        minutes = seconds / UTMSConfig.SECONDS_IN_MINUTE
        return f"{minutes:.1f}m"
    else:
        hours = seconds / UTMSConfig.SECONDS_IN_HOUR
        return f"{hours:.1f}h"


