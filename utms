def _display_detailed_version_issues(detailed_results: List[dict], version_status_counts: Dict[str, int]) -> None:
    """Display detailed listings of outdated and critical modules."""
    outdated_modules, critical_modules = _collect_modules_by_status(detailed_results)
    _display_outdated_modules(outdated_modules)
    _display_critical_modules(critical_modules)


def _collect_modules_by_status(detailed_results: List[dict]) -> Tuple[Dict[str, dict], Dict[str, dict]]:
    """Collect and deduplicate modules by their version status."""
    outdated_modules = {}
    critical_modules = {}
    
    for repo_result in detailed_results:
        repository_info = repo_result.get('repository', {})
        repository_name = repository_info.get('name', 'unknown')
        project_name = repository_info.get('project', '')
        
        for module in repo_result.get("modules", []):
            status = module.get("version_status", "unknown")
            
            # Create a unique key for deduplication (source + current version + target version + constraint)
            # This ensures that modules with different version states remain separate
            constraint = module.get('version', '') or 'none'
            module_key = f"{module.get('source', 'unknown')}:{module.get('resolved_version', 'unknown')}:{module.get('latest_version', 'unknown')}:{constraint}"
            
            if status == "outdated":
                _add_module_to_collection(outdated_modules, module_key, module, project_name, repository_name)
            elif status == "critical":
                _add_module_to_collection(critical_modules, module_key, module, project_name, repository_name)
    
    return outdated_modules, critical_modules


def _add_module_to_collection(modules_dict: Dict[str, dict], module_key: str, module: dict, project_name: str, repository_name: str) -> None:
    """Add a module to the collection, creating entry if needed."""
    if module_key not in modules_dict:
        modules_dict[module_key] = {
            'source': module.get('source', 'unknown'),
            'local_name': module.get('local_name', 'unknown'),
            'resolved_version': module.get('resolved_version', 'unknown'),
            'latest_version': module.get('latest_version', 'unknown'),
            'locations': []
        }
    # Add location to this module
    repo_path = f"{project_name}/{repository_name}" if project_name else repository_name
    modules_dict[module_key]['locations'].append(repo_path)


def _display_outdated_modules(outdated_modules: Dict[str, dict]) -> None:
    """Display outdated modules section."""
    if not outdated_modules:
        return
        
    safe_print(f"\n   🟠 Outdated modules (1 major version behind):")
    for module in outdated_modules.values():
        _display_module_info(module)


def _display_critical_modules(critical_modules: Dict[str, dict]) -> None:
    """Display critical modules section."""
    if not critical_modules:
        return
        
    safe_print(f"\n   🔴 Critical modules (2+ major versions behind):")
    for module in critical_modules.values():
        _display_module_info(module)


def _display_module_info(module: dict) -> None:
    """Display individual module information with formatting."""
    # Format location names with bold and quotes for prominence
    formatted_locations = []
    for location in module['locations']:
        formatted_locations.append(f"{UTMSConfig.ANSI_BOLD}\"{location}\"{UTMSConfig.ANSI_RESET}")
    locations_str = ", ".join(formatted_locations)
    
    if module['local_name'] != 'unknown':
        # Make local name prominent with bold formatting and quotes
        display_name = f"{UTMSConfig.ANSI_BOLD}\"{module['local_name']}\"{UTMSConfig.ANSI_RESET} ({module['source']})"
    else:
        display_name = module['source']
    safe_print(f"      • {display_name}")
    safe_print(f"        {module['resolved_version']} → {module['latest_version']} in {locations_str}")


