    def _discover_terraform_files(self, repository: Repository, organization: str, token: str, headers: Dict[str, str]) -> List[dict]:
        """Discover all Terraform files in the repository."""
        terraform_files = []
        
        try:
            if self.source_type == SourceType.AZURE_DEVOPS:
                # Get file tree from Azure DevOps
                items_url = f'https://dev.azure.com/{organization}/{repository.project_id}/_apis/git/repositories/{repository.id}/items?recursionLevel=Full&api-version=6.0'
                items_data = self._make_api_request(items_url, headers)
                
                for item in items_data.get('value', []):
                    if item.get('gitObjectType') == 'blob':  # It's a file
                        file_path = item['path']
                        
                        # Check if it's a Terraform file and not ignored
                        if (self.file_scanner.is_terraform_file(file_path) and 
                            not self.file_scanner.should_ignore_path(file_path) and
                            not self.file_scanner.is_variable_file(file_path)):
                            
                            terraform_files.append({
                                'path': file_path,
                                'objectId': item['objectId'],
                                'size': item.get('size', 0)
                            })
            
            elif self.source_type == SourceType.GITHUB:
                # Get file tree from GitHub
                tree_url = f'https://api.github.com/repos/{organization}/{repository.name}/git/trees/{repository.default_branch}?recursive=1'
                tree_data = self._make_api_request(tree_url, headers)
                
                for item in tree_data.get('tree', []):
                    if item.get('type') == 'blob':  # It's a file
                        file_path = item['path']
                        
                        # Check if it's a Terraform file and not ignored
                        if (self.file_scanner.is_terraform_file(file_path) and 
                            not self.file_scanner.should_ignore_path(file_path) and
                            not self.file_scanner.is_variable_file(file_path)):
                            
                            terraform_files.append({
                                'path': file_path,
                                'sha': item['sha'],
                                'size': item.get('size', 0)
                            })
        
        except Exception as e:
            # Parse platform-specific errors for better user experience
            error_str = str(e)
            ignored_errors = {"TF401019", "404"}
            
            if any(err in error_str for err in ignored_errors):
                logger.debug(f"Repository {repository.full_name} is disabled or inaccessible")
                return []  # Return empty list to indicate no files accessible
            
            logger.warning(f"Error discovering files in {repository.full_name}: {e}")
        
        return terraform_files
    
    def _test_repository_access(self, repository: Repository, organization: str, token: str) -> bool:
        """Test if repository is accessible by attempting a basic API call."""
        headers = self.auth_manager.get_headers(self.source_type, token)
        
        try:
            if self.source_type == SourceType.AZURE_DEVOPS:
                # Try to get repository info (lightweight call)
                repo_url = f'https://dev.azure.com/{organization}/{repository.project_id}/_apis/git/repositories/{repository.id}?api-version=6.0'
                self._make_api_request(repo_url, headers)
                return True
            elif self.source_type == SourceType.GITHUB:
                # Try to get repository info (lightweight call)
                repo_url = f'https://api.github.com/repos/{organization}/{repository.name}'
                self._make_api_request(repo_url, headers)
                return True
        except Exception as e:
            error_str = str(e)
            return not any(err in error_str for err in ["TF401019", "404"])
        
        return True
    
    def _get_file_content(self, repository: Repository, file_info: dict, organization: str, headers: Dict[str, str]) -> Optional[str]:
        """Get the content of a specific file."""
        file_size = file_info.get('size', 0)
        
        # Skip files that are too large
        if file_size > self.max_file_size_bytes:
            logger.debug(f"Skipping large file: {file_info['path']} ({file_size} bytes)")
            return None
        
        # Use streaming for larger files to improve memory efficiency
        if file_size > UTMSConfig.MIN_FILE_SIZE_FOR_STREAMING:
            return self._get_file_content_streaming(repository, file_info, organization, headers)
        else:
            return self._get_file_content_direct(repository, file_info, organization, headers)
    
    def _get_file_content_direct(self, repository: Repository, file_info: dict, organization: str, headers: Dict[str, str]) -> Optional[str]:
        """Get file content directly (for smaller files)."""
        
        try:
            if self.source_type == SourceType.AZURE_DEVOPS:
                # Get file content from Azure DevOps using the correct API endpoint
                # We need to add &$format=text to get actual content instead of JSON metadata
                encoded_path = urllib.parse.quote(file_info['path'])
                content_url = f"https://dev.azure.com/{organization}/{repository.project_id}/_apis/git/repositories/{repository.id}/items?path={encoded_path}&$format=text&api-version=6.0"
                
                req = urllib.request.Request(content_url, headers=headers)
                with urllib.request.urlopen(req, timeout=UTMSConfig.API_TIMEOUT_SECONDS) as response:
                    if response.status == 200:
                        return response.read().decode('utf-8', errors='ignore')
            
            elif self.source_type == SourceType.GITHUB:
                # Get file content from GitHub using Contents API
                encoded_path = urllib.parse.quote(file_info['path'])
                content_url = f"https://api.github.com/repos/{organization}/{repository.name}/contents/{encoded_path}?ref={repository.default_branch}"
                
                req = urllib.request.Request(content_url, headers=headers)
                with urllib.request.urlopen(req, timeout=UTMSConfig.API_TIMEOUT_SECONDS) as response:
                    if response.status == 200:
                        import json
                        data = json.loads(response.read().decode('utf-8'))
                        # GitHub returns base64 encoded content
                        if 'content' in data:
                            return base64.b64decode(data['content']).decode('utf-8', errors='ignore')
        
        except Exception as e:
            logger.debug(f"Error getting file content for {file_info['path']}: {e}")
        
        return None
    
    def _get_file_content_streaming(self, repository: Repository, file_info: dict, organization: str, headers: Dict[str, str]) -> Optional[str]:
        """Get file content using streaming (for larger files)."""
        
        try:
            if self.source_type == SourceType.AZURE_DEVOPS:
                encoded_path = urllib.parse.quote(file_info['path'])
                content_url = f"https://dev.azure.com/{organization}/{repository.project_id}/_apis/git/repositories/{repository.id}/items?path={encoded_path}&$format=text&api-version=6.0"
                
                req = urllib.request.Request(content_url, headers=headers)
                
                content_chunks = []
                with urllib.request.urlopen(req, timeout=UTMSConfig.API_TIMEOUT_SECONDS) as response:
                    if response.status == 200:
                        # Stream content in chunks
                        while True:
                            chunk = response.read(UTMSConfig.STREAM_CHUNK_SIZE)
                            if not chunk:
                                break
                            content_chunks.append(chunk)
                        
                        # Decode all chunks together
                        return b''.join(content_chunks).decode('utf-8', errors='ignore')
            
            elif self.source_type == SourceType.GITHUB:
                # For larger files, use raw content URL which doesn't require base64 decoding
                encoded_path = urllib.parse.quote(file_info['path'])
                content_url = f"https://raw.githubusercontent.com/{organization}/{repository.name}/{repository.default_branch}/{encoded_path}"
                
                req = urllib.request.Request(content_url, headers=headers)
                
                content_chunks = []
                with urllib.request.urlopen(req, timeout=UTMSConfig.API_TIMEOUT_SECONDS) as response:
                    if response.status == 200:
                        # Stream content in chunks
                        while True:
                            chunk = response.read(UTMSConfig.STREAM_CHUNK_SIZE)
                            if not chunk:
                                break
                            content_chunks.append(chunk)
                        
                        # Decode all chunks together
                        return b''.join(content_chunks).decode('utf-8', errors='ignore')
        
        except Exception as e:
            logger.debug(f"Error streaming file content for {file_info['path']}: {e}")
        
        return None


class AuthenticationManager:
    """Simple PAT-based authentication manager."""
    
    def authenticate(self, source_type: SourceType, organization: str = "", token: str = None) -> Optional[str]:
        """
        Get authentication token from --token flag or environment variables.
        
        Priority:
        1. --token command line argument
        2. Environment variables (AZURE_DEVOPS_PAT, GITHUB_TOKEN, etc.)
        3. Fail with clear error message
        """
        # If token provided via CLI, use it
        if token:
            if self._validate_token(source_type, token, organization):
                logger.debug(f"Using token from --token argument")
                return token
            else:
                logger.error("Token validation failed")
                return None
        
        # Try environment variables
        env_vars = self._get_env_var_names(source_type)
        for env_var in env_vars:
            env_token = os.getenv(env_var)
            if env_token and env_token.strip():
                if self._validate_token(source_type, env_token.strip(), organization):
                    logger.debug(f"Using token from environment variable: {env_var}")
                    return env_token.strip()
        
        # No token found
        logger.error(f"No authentication token provided")
        return None
    
    def _get_env_var_names(self, source_type: SourceType) -> List[str]:
        """Get list of environment variable names to check for this source type."""
        if source_type == SourceType.AZURE_DEVOPS:
            return ['AZURE_DEVOPS_PAT', 'AZURE_PAT', 'ADO_PAT']
        if source_type == SourceType.GITHUB:
            return ['GITHUB_TOKEN', 'GH_TOKEN']
        return []
    
    def _validate_token(self, source_type: SourceType, token: str, organization: str = "") -> bool:
        """Validate token by making a test API call."""
        try:
            if source_type == SourceType.AZURE_DEVOPS:
                return self._validate_azure_devops_token(token, organization)
            if source_type == SourceType.GITHUB:
                return self._validate_github_token(token)
            return False
        except Exception as e:
            logger.debug(f"Token validation failed: {e}")
            return False
    
    def _validate_azure_devops_token(self, token: str, organization: str) -> bool:
        """Validate Azure DevOps token."""
        try:
            url = f'https://dev.azure.com/{organization}/_apis/projects?api-version=6.0'
            headers = self.get_headers(SourceType.AZURE_DEVOPS, token)
            req = urllib.request.Request(url)
            for key, value in headers.items():
                req.add_header(key, value)
            
            with urllib.request.urlopen(req, timeout=UTMSConfig.TOKEN_VALIDATION_TIMEOUT) as response:
                return response.status == 200
        except (urllib.error.HTTPError, Exception) as e:
            logger.debug(f"Token validation error: {e}")
            return False
    
    def _validate_github_token(self, token: str) -> bool:
        """Validate GitHub token."""
        try:
            url = 'https://api.github.com/user'
            headers = self.get_headers(SourceType.GITHUB, token)
            req = urllib.request.Request(url)
            for key, value in headers.items():
                req.add_header(key, value)
            
            with urllib.request.urlopen(req, timeout=UTMSConfig.TOKEN_VALIDATION_TIMEOUT) as response:
                return response.status == 200
        except (urllib.error.HTTPError, Exception) as e:
            logger.debug(f"Token validation error: {e}")
            return False
    
    def get_headers(self, source_type: SourceType, token: str) -> Dict[str, str]:
        """Get HTTP headers for API requests."""
        if source_type == SourceType.AZURE_DEVOPS:
            auth_string = base64.b64encode(f':{token}'.encode()).decode()
            return {
                'Authorization': f'Basic {auth_string}',
                'Accept': 'application/json'
            }
        if source_type == SourceType.GITHUB:
            return {
                'Authorization': f'Bearer {token}',
                'Accept': 'application/vnd.github+json'
            }
        return {}


