class GitModuleVersionChecker:
    """Checks for outdated Git module versions."""
    
    def __init__(self, auth_manager: 'AuthenticationManager'):
        self.auth_manager = auth_manager
        self._version_cache = {}  # Cache to avoid duplicate API calls
        self._github_token = None
        self._azure_token = None
    
    def set_tokens(self, azure_token: Optional[str] = None, github_token: Optional[str] = None):
        """Set authentication tokens for checking module versions."""
        self._azure_token = azure_token
        self._github_token = github_token
    
    def check_module_version(self, module: ModuleReference) -> tuple[Optional[str], Optional[bool]]:
        """Check if a Git module is outdated. Returns (latest_version, is_outdated)."""
        if module.source_type != ModuleSourceType.GIT:
            return None, None
        
        try:
            git_info = self._parse_git_url(module.source)
            if not git_info:
                return None, None
            
            # Get the appropriate token for this repository type
            token = self._get_token_for_git_type(git_info['type'])
            # Note: token can be None for public repositories
            
            # Get latest version from the source repository
            latest_version = self._get_latest_version(git_info, token)
            if not latest_version:
                return None, None
            
            # Compare versions if module has a version specified
            is_outdated = None
            if module.version:
                is_outdated = self._compare_versions(module.version, latest_version)
            
            return latest_version, is_outdated
            
        except Exception as e:
            logger.debug(f"Could not check version for {module.source}: {e}")
            return None, None
    
    def _get_token_for_git_type(self, git_type: str) -> Optional[str]:
        """Get the appropriate token for a Git repository type."""
        if git_type == 'github':
            return self._github_token
        elif git_type == 'azure-devops':
            return self._azure_token
        return None
    
    def _parse_git_url(self, source: str) -> Optional[dict]:
        """Parse Git URL to extract host, org, and repo."""
        try:
            # Handle git:: prefix
            url = source.replace('git::', '')
            
            # Remove query parameters (e.g., ?ref=v1.0.0)
            if '?' in url:
                url = url.split('?')[0]
            
            # Remove .git suffix
            url = url.rstrip('.git')
            
            # GitHub patterns
            github_patterns = [
                r'https?://github\.com/([^/]+)/([^/]+)',
                r'git@github\.com:([^/]+)/([^/]+)',
                r'ssh://git@github\.com/([^/]+)/([^/]+)'
            ]
            
            for pattern in github_patterns:
                match = re.match(pattern, url)
                if match:
                    return {
                        'type': 'github',
                        'org': match.group(1),
                        'repo': match.group(2)
                    }
            
            # Azure DevOps patterns
            # https://dev.azure.com/org/project/_git/repo
            # https://org@dev.azure.com/org/project/_git/repo
            ado_pattern = r'https?://.*dev\.azure\.com/([^/]+)/([^/]+)/_git/([^/]+)'
            match = re.match(ado_pattern, url)
            if match:
                return {
                    'type': 'azure-devops',
                    'org': match.group(1),
                    'project': match.group(2),
                    'repo': match.group(3)
                }
            
            return None
            
        except Exception as e:
            logger.debug(f"Could not parse Git URL {source}: {e}")
            return None
    
    def _get_latest_version(self, git_info: dict, token: str) -> Optional[str]:
        """Get the latest version/tag from the Git repository."""
        cache_key = f"{git_info['type']}:{git_info['org']}:{git_info.get('project', '')}:{git_info['repo']}"
        
        # Check cache first
        if cache_key in self._version_cache:
            return self._version_cache[cache_key]
        
        try:
            if git_info['type'] == 'github':
                latest = self._get_github_latest_version(git_info['org'], git_info['repo'], token)
            elif git_info['type'] == 'azure-devops':
                latest = self._get_azure_devops_latest_version(
                    git_info['org'], git_info['project'], git_info['repo'], token
                )
            else:
                return None
            
            # Cache the result
            self._version_cache[cache_key] = latest
            return latest
            
        except Exception as e:
            logger.debug(f"Could not get latest version for {cache_key}: {e}")
            return None
    
    def _get_github_latest_version(self, org: str, repo: str, token: Optional[str]) -> Optional[str]:
        """Get latest release or tag from GitHub."""
        try:
            # Build headers - works with or without token
            if token:
                headers = self.auth_manager.get_headers(SourceType.GITHUB, token)
            else:
                headers = {'Accept': 'application/vnd.github+json'}
            
            # Try latest release first
            url = f'https://api.github.com/repos/{org}/{repo}/releases/latest'
            req = urllib.request.Request(url, headers=headers)
            
            try:
                with urllib.request.urlopen(req, timeout=UTMSConfig.API_TIMEOUT_SECONDS) as response:
                    if response.status == 200:
                        data = json.loads(response.read().decode())
                        return data.get('tag_name')
            except urllib.error.HTTPError as e:
                # No releases or auth required, try tags
                if e.code == 404:
                    pass  # No releases, will try tags
                elif e.code == 401:
                    logger.debug(f"GitHub auth required for {org}/{repo} (private repository)")
                    return None
                else:
                    pass  # Try tags anyway
            
            # Fall back to latest tag
            url = f'https://api.github.com/repos/{org}/{repo}/tags'
            req = urllib.request.Request(url, headers=headers)
            with urllib.request.urlopen(req, timeout=UTMSConfig.API_TIMEOUT_SECONDS) as response:
                if response.status == 200:
                    tags = json.loads(response.read().decode())
                    if tags and len(tags) > 0:
                        return tags[0]['name']
            
            return None
            
        except urllib.error.HTTPError as e:
            if e.code == 401:
                logger.debug(f"GitHub auth required for {org}/{repo} (private repository)")
            else:
                logger.debug(f"GitHub version check failed for {org}/{repo}: HTTP {e.code}")
            return None
        except Exception as e:
            logger.debug(f"GitHub version check failed for {org}/{repo}: {e}")
            return None
    
    def _get_azure_devops_latest_version(self, org: str, project: str, repo: str, token: str) -> Optional[str]:
        """Get latest tag from Azure DevOps."""
        try:
            headers = self.auth_manager.get_headers(SourceType.AZURE_DEVOPS, token)
            
            # Get tags (refs/tags/*)
            url = f'https://dev.azure.com/{org}/{project}/_apis/git/repositories/{repo}/refs?filter=tags&api-version=6.0'
            req = urllib.request.Request(url, headers=headers)
            
            with urllib.request.urlopen(req, timeout=UTMSConfig.API_TIMEOUT_SECONDS) as response:
                if response.status == 200:
                    data = json.loads(response.read().decode())
                    refs = data.get('value', [])
                    
                    # Extract version tags and sort
                    version_tags = []
                    for ref in refs:
                        name = ref.get('name', '')
                        if name.startswith('refs/tags/'):
                            tag = name.replace('refs/tags/', '')
                            version_tags.append(tag)
                    
                    if version_tags:
                        # Sort versions (simple sorting, semantic version aware)
                        version_tags.sort(key=lambda v: self._version_sort_key(v), reverse=True)
                        return version_tags[0]
            
            return None
            
        except Exception as e:
            logger.debug(f"Azure DevOps version check failed for {org}/{project}/{repo}: {e}")
            return None
    
    def _compare_versions(self, current: str, latest: str) -> bool:
        """Compare versions and return True if current is outdated."""
        # Clean version strings
        current_clean = current.lstrip('vV').strip()
        latest_clean = latest.lstrip('vV').strip()
        
        # If they're the same, not outdated
        if current_clean == latest_clean:
            return False
        
        # Try semantic version comparison
        try:
            current_parts = [int(x) for x in current_clean.split('.')]
            latest_parts = [int(x) for x in latest_clean.split('.')]
            
            # Pad to same length
            max_len = max(len(current_parts), len(latest_parts))
            current_parts += [0] * (max_len - len(current_parts))
            latest_parts += [0] * (max_len - len(latest_parts))
            
            # Compare
            return current_parts < latest_parts
            
        except (ValueError, AttributeError):
            # Fall back to string comparison
            return current_clean < latest_clean
    
    def _version_sort_key(self, version: str) -> tuple:
        """Create a sort key for version strings."""
        try:
            # Remove 'v' or 'V' prefix
            clean = version.lstrip('vV')
            # Split into numeric parts
            parts = [int(x) for x in clean.split('.')]
            return tuple(parts)
        except (ValueError, AttributeError):
            # Fall back to string sorting
            return (0, 0, 0)


class ResultsManager:
    """Manages scanning results output and storage."""
    
    def __init__(self, output_dir: str = "results"):
        self.output_dir = output_dir
        self._ensure_output_directory()
    
    def _ensure_output_directory(self):
        """Create output directory if it doesn't exist."""
        if not os.path.exists(self.output_dir):
            os.makedirs(self.output_dir)
            logger.info(f"📁 Created output directory: {self.output_dir}")
    
    def save_scan_results(self, result: ScanResult, organization: str, project: str, repository: str, source_type: SourceType, filters: list = None) -> str:
        """Save scan results to JSON file and return filepath."""
        # Build output with metadata
        output_data = self._build_output_with_metadata(result, organization, project, repository, source_type, filters)
        
        # Save to file
        return self._save_output_data_to_file(output_data, organization, project, repository)
    
    def _build_output_with_metadata(self, result: ScanResult, organization: str, project: str, repository: str, source_type: SourceType, filters: list = None) -> dict:
        """Build output with repository metadata and modules."""
        modules = self._build_simple_output(result, filters)
        
        return {
            "metadata": {
                "organization": organization,
                "project": project if source_type == SourceType.AZURE_DEVOPS else None,
                "repository": repository,
                "source_type": source_type.value,
                "scan_timestamp": result.scan_timestamp,
                "total_modules_found": len(modules) if filters else result.total_modules_found,
                "total_files_scanned": result.total_files_scanned
            },
            "modules": modules
        }
    
    def _build_simple_output(self, result: ScanResult, filters: list = None) -> list:
        """Build simple output - just a list of modules with optional filtering."""
        modules = result.modules
        
        # Apply filters if specified
        if filters:
            filtered = []
            for module in modules:
                include = False
                
                # Check if module matches any filter criteria
                if "outdated" in filters and module.is_outdated is True:
                    include = True
                if "local" in filters and module.source_type == ModuleSourceType.LOCAL:
                    include = True
                
                if include:
                    filtered.append(module)
            
            modules = filtered
        
        return [
            {
                "file_path": module.file_path,
                "local_name": module.local_name,
                "source": module.source,
                "source_type": module.source_type.value,
                "version": module.version,
                "latest_version": module.latest_version,
                "is_outdated": module.is_outdated
            }
            for module in modules
        ]
    
    def _save_output_data_to_file(self, output_data: dict, organization: str, project: str, repository: str) -> str:
        """Save output data to JSON file."""
        # Filename format: org-project-repo.json
        filename = f"{organization.lower()}-{project.lower()}-{repository.lower()}.json"
        filepath = os.path.join(self.output_dir, filename)
        
        try:
            with open(filepath, 'w', encoding='utf-8') as f:
                json.dump(output_data, f, indent=2, ensure_ascii=False)
        except OSError as e:
            logger.error(f"Failed to write results to {filepath}: {e}")
            raise
        except (TypeError, ValueError) as e:
            logger.error(f"Failed to serialize results data: {e}")
            raise json.JSONEncodeError(f"Data serialization failed: {e}", str(output_data), 0)
        
        logger.info(f"💾 Results saved to: {filepath}")
        return filepath
    
    def clean_specific_result(self, organization: str, project: str, repository: str):
        """Clean existing result file for a specific repository."""
        filename = f"{organization.lower()}-{project.lower()}-{repository.lower()}.json"
        filepath = os.path.join(self.output_dir, filename)
        
        if os.path.exists(filepath):
            try:
                os.remove(filepath)
                logger.info(f"🗑️  Cleaned existing result file: {filepath}")
                safe_print(f"🗑️  Cleaned existing result file")
            except OSError as e:
                logger.warning(f"Failed to clean file {filepath}: {e}")


def parse_arguments() -> argparse.Namespace:
    """Parse command line arguments."""
    parser = argparse.ArgumentParser(
        prog="utms",
        description="Universal Terraform Module Scanner (UTMS) - Scan source repositories for Terraform module references",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""Authentication Methods (tried in order):
  1. --token command line argument
  2. Environment variables (AZURE_DEVOPS_PAT, GITHUB_TOKEN, etc.)

Output:
  JSON files are automatically generated in the 'results/' directory.
  Output contains only the modules found in the specified repository.

Examples:
  utms --source azure-devops --organization my-org --project MyProject --repository my-repo --token "pat_token"
  utms --source azure-devops --organization my-org --project Platform --repository infra-core --debug
  utms --source azure-devops --organization my-org --project Platform --repository infra-core --clean
        """
    )
    
    # Required arguments
    parser.add_argument(
        "--source",
        required=True,
        choices=[e.value for e in SourceType],
        help="Source type to scan (azure-devops, github)"
    )
    parser.add_argument(
        "--organization", 
        required=True,
        help="Organization name (Azure DevOps organization or GitHub organization/user)"
    )
    parser.add_argument(
        "--project",
        required=True,
        help="Project name (required for single repository scanning)"
    )
    parser.add_argument(
        "--repository",
        required=True,
        help="Repository name to scan"
    )
    parser.add_argument(
        "--token",
        help="Authentication token (overrides auto-detection)"
    )
    
    # Optional arguments
    parser.add_argument(
        "--clean",
        action="store_true",
        help="Clean existing result files before generating new ones"
    )
    parser.add_argument(
        "--filter",
        action="append",
        choices=["outdated", "local"],
        help="Filter results (can be specified multiple times): 'outdated' for outdated Git modules, 'local' for local modules"
    )
    parser.add_argument(
        "--debug",
        action="store_true", 
        help="Enable debug output"
    )
    parser.add_argument(
        "--version",
        action="version",
        version="UTMS"
    )
    
    return parser.parse_args()


def initialize_application(args) -> Tuple[SourceType, AuthenticationManager, str]:
    """Initialize application components and authenticate."""
    if args.debug:
        logging.getLogger().setLevel(logging.DEBUG)
    
    # Initialize components
    source_type = SourceType(args.source)
    auth_manager = AuthenticationManager()
    
    # Authenticate with token from --token flag or environment variables
    token = auth_manager.authenticate(source_type, args.organization, args.token)
    if not token:
        safe_print("Error: Authentication failed. Please check your token (use --token or environment variables).")
        raise AuthenticationError("Authentication failed")
    
    return source_type, auth_manager, token


def initialize_scanning_components(auth_manager: AuthenticationManager, source_type: SourceType, results_dir: str) -> Tuple[TerraformFileScanner, RepositoryDiscovery, RepositoryScanner, ResultsManager]:
    """Initialize all scanning components."""
    file_scanner = TerraformFileScanner()
    repo_discovery = RepositoryDiscovery(source_type, auth_manager)
    version_checker = GitModuleVersionChecker(auth_manager)
    repo_scanner = RepositoryScanner(source_type, auth_manager, file_scanner, version_checker)
    results_manager = ResultsManager(results_dir)
    
    # Display initialization info in a clean, organized way
    logger.debug("Scanner initialized")
    
    return file_scanner, repo_discovery, repo_scanner, results_manager


def get_single_repository(args: argparse.Namespace, repo_discovery: RepositoryDiscovery, token: str) -> Optional[Repository]:
    """Get the single repository to scan."""
    logger.debug("Locating repository")
    
    # Get the specific repository
    repository = repo_discovery.get_repository(args.organization, args.project, args.repository, token)
    
    if not repository:
        safe_print(f"Error: Repository not found: {args.organization}/{args.project}/{args.repository}")
        return None
    
    logger.debug(f"Repository located: {repository.full_name}")
    
    return repository


def execute_single_repository_scan(args: argparse.Namespace, repository: Repository, repo_scanner: RepositoryScanner, results_manager: ResultsManager, token: str, source_type: SourceType) -> int:
    """Execute scan on single repository and save results."""
    from datetime import datetime
    
    logger.debug("Starting Terraform module scanning")
    
    start_time = datetime.now()
    
    # Scan the repository
    try:
        result = repo_scanner.scan_repository(repository, args.organization, token)
    except Exception as e:
        safe_print(f"Error: Failed to scan repository: {e}")
        logger.error(f"Scan error: {e}")
        return 1
    
    # Save results
    output_file = results_manager.save_scan_results(
        result, 
        args.organization, 
        args.project, 
        args.repository,
        source_type,
        filters=args.filter
    )
    
    # Display minimal summary for CI/CD
    total_time = (datetime.now() - start_time).total_seconds()
    safe_print(f"Scanned {result.total_files_scanned} files, found {result.total_modules_found} modules ({result.local_modules_found} local, {result.git_modules_found} git) in {format_duration(total_time)}")
    safe_print(f"Results: {output_file}")
    
    return 0


def setup_application(args: argparse.Namespace) -> None:
    """Setup application configuration and logging."""
    # Ignore SIGPIPE to prevent broken pipe errors when piping to head/tail
    signal.signal(signal.SIGPIPE, signal.SIG_DFL)
    
    if args.debug:
        # Enable both INFO and DEBUG messages in debug mode
        logging.getLogger().setLevel(logging.INFO)
        logger.debug(f"UTMS - Source: {args.source}")
        safe_print(f"Debug mode enabled")


def run_application_workflow(args: argparse.Namespace) -> int:
    """Run the complete application workflow."""
    try:
        # Initialize application and authenticate
        source_type, auth_manager, token = initialize_application(args)
        
        # Create results directory relative to UTMS script location
        script_dir = os.path.dirname(os.path.abspath(__file__))
        results_dir = os.path.join(script_dir, "results")
        
        # Initialize scanning components
        file_scanner, repo_discovery, repo_scanner, results_manager = initialize_scanning_components(auth_manager, source_type, results_dir)
        
        # Clean existing result file if requested
        if args.clean:
            results_manager.clean_specific_result(args.organization, args.project, args.repository)
        
        # Get the specific repository
        repository = get_single_repository(args, repo_discovery, token)
        if not repository:
            return 1
        
        # Execute single repository scan
        return execute_single_repository_scan(args, repository, repo_scanner, results_manager, token, source_type)
        
    except KeyboardInterrupt:
        safe_print(f"\n⏹️  Scan interrupted by user")
        return UTMSConfig.EXIT_CODE_INTERRUPT
    except Exception as e:
        safe_print(f"\n❌ Unexpected error: {e}")
        logger.error(f"Application error: {e}")
        return 1


def main() -> int:
    """Main application entry point."""
    args = parse_arguments()
    setup_application(args)
    return run_application_workflow(args)

if __name__ == "__main__":
    sys.exit(main())
