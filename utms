@dataclass
class UTMSConfig:
    """Configuration constants for UTMS."""
    # File scanning limits
    MAX_FILE_SIZE_MB: int = 1  # megabytes
    MAX_FILE_SIZE_BYTES: int = 1048576  # 1MB in bytes
    
    # API timeouts
    API_TIMEOUT_SECONDS: int = 30  # seconds
    TOKEN_VALIDATION_TIMEOUT: int = 10  # seconds
    
    # Performance settings
    MAX_CONCURRENT_FILES: int = 10  # Limit concurrent file processing
    CACHE_SIZE_LIMIT: int = 1000    # LRU cache size for API responses
    STREAM_CHUNK_SIZE: int = 8192   # Bytes per streaming chunk
    MIN_FILE_SIZE_FOR_STREAMING: int = 102400  # 100KB - minimum size for streaming
    MIN_FILES_FOR_CONCURRENT_PROCESSING: int = 5  # Minimum files to use concurrent processing
    
    # Debug and display
    CONTENT_PREVIEW_LENGTH: int = 200  # characters
    EXIT_CODE_INTERRUPT: int = 130  # keyboard interrupt
    
    # Logging formats
    LOG_FORMAT = '%(asctime)s - %(levelname)s - %(message)s'
    LOG_DATE_FORMAT = '%Y-%m-%d %H:%M:%S'


def safe_print(*args, **kwargs):
    """Print function that handles BrokenPipeError gracefully."""
    try:
        print(*args, **kwargs)
    except BrokenPipeError:
        # Silence broken pipe errors (e.g., when piping to head)
        try:
            sys.stdout.close()
        except OSError:
            pass
        sys.exit(0)


def format_duration(seconds: float) -> str:
    """Format duration in human-readable format."""
    if seconds < 60:
        return f"{seconds:.1f}s"
    elif seconds < 3600:
        return f"{seconds / 60:.1f}m"
    else:
        return f"{seconds / 3600:.1f}h"


# Configure logging - default to WARNING, INFO only in debug mode
